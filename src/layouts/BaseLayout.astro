---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { siteMeta } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  variant?: "blog" | "academic";
  pathname?: string;
  canonicalPath?: string;
  image?: string;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  variant = "blog",
  pathname = Astro.url.pathname,
  canonicalPath = pathname,
  image
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : undefined;

const navItems = [
  { href: "/", label: "Blog" },
  { href: "/papers", label: "Paper Radar" },
  { href: "/research", label: "Research" },
  { href: "/about", label: "About" }
];
---

<!doctype html>
<html lang={variant === "academic" ? "en" : "zh-CN"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  </head>
  <body class:list={["site-root", "blog-surface", variant === "academic" ? "academic-content" : undefined]}>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">TxTxx</span>
          <span class="brand-title">Notes, research, and public drafts</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {
            navItems.map((item) => (
              <a class={pathname === item.href ? "active" : ""} href={item.href}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="site-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <div>{siteMeta.title}</div>
          <div class="muted">{siteMeta.tagline}</div>
        </div>
        <div class="site-footer-links">
          <a href={`mailto:${siteMeta.email}`}>Email</a>
          <a href={siteMeta.github}>GitHub</a>
          <a href={siteMeta.scholar}>Scholar</a>
          <a href={siteMeta.cv}>CV</a>
        </div>
      </div>
    </footer>
  </body>
</html>
