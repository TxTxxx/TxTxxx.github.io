---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric"
});
---

<BaseLayout title={`${post.data.title} | TxTxx`} description={post.data.summary} pathname="/blog">
  <article class="post-article">
    <header class="post-header">
      <div class="eyebrow">Essay</div>
      <div class="post-header-copy">
        <h1>{post.data.title}</h1>
        {
          post.data.cover_image && (
            <div class="post-header-media">
              <div class="post-header-media-frame">
                <img
                  src={post.data.cover_image}
                  alt={post.data.cover_alt ?? post.data.title}
                  loading="eager"
                />
              </div>
            </div>
          )
        }
      </div>
      <div class="post-header-bottom">
        <p>{post.data.summary}</p>
        <div class="post-meta">
          <span>{formattedDate}</span>
          <span>{post.data.tags.join(" / ")}</span>
        </div>
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-article {
    max-width: 54rem;
    margin: 0 auto;
  }

  .post-header {
    padding: 0 0 2rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .post-header-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) 26rem;
    align-items: flex-start;
    gap: 1.5rem;
    min-width: 0;
    margin-top: 0.5rem;
  }

  .post-header h1 {
    margin: 0;
    font-size: clamp(1.95rem, 4.1vw, 3.6rem);
    line-height: 1.02;
    font-family: var(--serif);
    min-width: 0;
    max-width: 14ch;
  }

  .post-header-bottom {
    margin-top: 1rem;
    max-width: 44rem;
  }

  .post-header p,
  .post-meta {
    color: var(--muted);
  }

  .post-meta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
    margin-top: 1rem;
  }

  .post-header-media {
    width: 26rem;
    aspect-ratio: 16 / 10;
    justify-self: end;
    padding: 0.8rem;
    border-radius: 1.6rem;
    background:
      var(--paper-gradient),
      linear-gradient(135deg, var(--accent-soft), transparent 45%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .post-header-media-frame {
    width: 100%;
    height: 100%;
    border-radius: 1.2rem;
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
  }

  .post-header-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--surface-subtle);
  }

  .post-body {
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.9;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    font-family: var(--sans);
    margin-top: 2.4rem;
    line-height: 1.15;
  }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
  }

  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--accent);
    background: var(--surface-subtle);
  }

  .post-body :global(video) {
    display: block;
    width: 100%;
    max-height: 72vh;
    margin: 2rem 0;
    border: 1px solid var(--line);
    border-radius: 1.2rem;
    background: var(--code-bg);
    box-shadow: var(--shadow);
    object-fit: contain;
  }

  .post-body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .post-body :global(pre) {
    padding: 1rem;
    border-radius: 1rem;
    background: var(--code-bg);
    overflow-x: auto;
  }

  .post-body :global(pre code) {
    color: var(--code-text);
  }

  .post-body :global(table) {
    width: 100%;
    margin: 1.8rem 0;
    border-collapse: collapse;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .post-body :global(thead) {
    background: var(--accent-soft);
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: 0.9rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .post-body :global(th) {
    font-family: var(--sans);
    font-weight: 600;
    color: var(--text);
  }

  .post-body :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .post-body :global(tr > * + *) {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .post-header-copy {
      grid-template-columns: 1fr;
    }

    .post-header h1,
    .post-header-bottom {
      max-width: none;
    }

    .post-header-media {
      width: min(100%, 22rem);
      justify-self: start;
    }

    .post-body :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
      font-size: 0.92rem;
    }
  }
</style>
