---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { optimizedImage } from "../../lib/optimized-image.mjs";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
const cover = await optimizedImage(post.data.cover_image);
const transitionName = `post-${Buffer.from(post.id).toString("hex")}`;
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric"
});
---

<BaseLayout title={`${post.data.title} | TxTxx`} description={post.data.summary} pathname="/blog">
  <article class="post-article">
    <header class="post-header">
      <a class="back-link" data-reading-back href={`/#${transitionName}`}>← 返回博客</a>
      <div class="post-header-copy">
        <h1>{post.data.title}</h1>
        <p>{post.data.summary}</p>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formattedDate}</time>
          <span>{post.data.tags.join(" / ")}</span>
        </div>
      </div>
      {
        post.data.cover_image && (
          <div class="post-header-media" data-cover-fit={post.data.cover_fit ?? "contain"}>
            <div class="post-header-media-frame" data-post-cover style={`--post-transition: ${transitionName}`}>
              <img
                src={post.data.cover_image}
                srcset={cover?.srcset}
                sizes="(max-width: 900px) calc(100vw - 56px), 840px"
                alt={post.data.cover_alt ?? post.data.title}
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        )
      }
    </header>

    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-article { max-width: 54rem; min-width: 0; margin: 0 auto; }

  .post-header {
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.5rem;
  }

  .post-header > .back-link,
  .post-header-copy,
  .post-body { max-width: 46rem; margin-inline: auto; }

  .back-link { display: block; color: var(--muted); font-size: 0.875rem; }
  .back-link:hover { color: var(--accent); }

  .post-header-copy { margin-top: 1rem; }

  .post-header h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.3;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .post-header p {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .post-meta {
    display: flex;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .post-meta time { font-variant-numeric: tabular-nums; }

  .post-header-media {
    width: 100%;
    margin-top: 2rem;
    padding: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--bg-elevated);
  }

  .post-header-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.65rem;
    overflow: hidden;
    background: var(--surface-subtle);
  }

  .post-header-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .post-header-media[data-cover-fit="cover"] img { object-fit: cover; }

  .post-body {
    min-width: 0;
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }

  .post-body :global(p) { margin: 1.25rem 0; }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    font-family: var(--sans);
    margin: 2.75rem 0 1rem;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }

  .post-body :global(h1) { font-size: 1.75em; }
  .post-body :global(h2) { font-size: 1.4em; }
  .post-body :global(h3) { font-size: 1.15em; }
  .post-body :global(h4) { font-size: 1em; }
  .post-body :global(> :first-child),
  .post-body :global(> .post-title-anchor:first-child + *) { margin-top: 0; }

  .post-body :global(.post-title-anchor) { display: block; height: 0; }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 0.2em;
  }

  .post-body :global(a:hover) { text-decoration-color: currentColor; }
  .post-body :global(ul), .post-body :global(ol) { padding-left: 1.5em; }
  .post-body :global(li) { margin-block: 0.45rem; }

  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .post-body :global(blockquote > :first-child) { margin-top: 0; }
  .post-body :global(blockquote > :last-child) { margin-bottom: 0; }

  .post-body :global(.post-addendum) {
    margin: 2.5rem 0 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 0.65rem 0.65rem 0;
    background: var(--bg-elevated);
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .post-body :global(.addendum-header) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-body :global(.addendum-header span) { color: var(--accent); }
  .post-body :global(.addendum-header time) { color: var(--muted); font-variant-numeric: tabular-nums; }
  .post-body :global(.post-addendum > p) { margin: 0.65rem 0; }
  .post-body :global(.post-addendum > :last-child) { margin-bottom: 0; }
  .post-body :global(.post-addendum h2), .post-body :global(.post-addendum h3) { margin-top: 1.25rem; }

  @media (max-width: 640px) {
    .post-body :global(.post-addendum) { padding: 1rem; }
  }

  .post-body :global(img) {
    height: auto;
    margin-inline: auto;
    border-radius: 0.5rem;
  }

  .post-body :global(video) {
    display: block;
    width: 100%;
    max-height: 72vh;
    margin: 2rem 0;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--code-bg);
    object-fit: contain;
  }

  .post-body :global(code) { font-family: var(--mono); font-size: 0.875em; }
  .post-body :global(:not(pre) > code) { padding: 0.15em 0.35em; border-radius: 0.25rem; background: var(--surface-subtle); }

  .post-body :global(pre) {
    max-width: 100%;
    margin: 1.75rem 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--code-bg);
    line-height: 1.75;
    overflow-x: auto;
    overflow-wrap: normal;
  }

  .post-body :global(pre code) { color: var(--code-text); }
  .post-body :global(.katex-display) { padding-block: 0.4rem; overflow-x: auto; overflow-y: hidden; }
  .post-body :global(hr) { margin: 2.75rem 0; border: 0; border-top: 1px solid var(--line); }

  .post-body :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    border-spacing: 0;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--bg-elevated);
    font-family: var(--sans);
    font-size: 0.9375rem;
    line-height: 1.75;
    overflow-wrap: normal;
  }

  .post-body :global(thead) { background: var(--surface-subtle); }

  .post-body :global(th),
  .post-body :global(td) {
    min-width: 7rem;
    padding: 0.85rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .post-body :global(th) { font-weight: 600; color: var(--text); }
  .post-body :global(tbody tr:last-child td) { border-bottom: none; }
  .post-body :global(tr > * + *) { border-left: 1px solid var(--line); }

  @media (max-width: 640px) {
    .post-header { margin-bottom: 2rem; padding-bottom: 1.75rem; }
    .post-header h1 { font-size: clamp(1.8rem, 6vw, 2.4rem); line-height: 1.4; }
    .post-header p { font-size: 1rem; }
    .post-header-media { margin-top: 1.5rem; }
    .post-body { font-size: 1.0625rem; line-height: 1.9; }
    .post-body :global(pre) { padding: 1rem; }
    .post-body :global(th), .post-body :global(td) { padding: 0.75rem; }
  }
</style>
