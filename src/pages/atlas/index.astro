---
import researchGraph from "../../data/researchGraph.json";
import ThemeHead from "../../components/ThemeHead.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";

const clusters = [
  { id: "vla", label: "VLA", mapLabel: "VLA", color: "#426f80", center: [-10, 4, 0] },
  { id: "world", label: "World models", mapLabel: "WORLD", color: "#796595", center: [-4, -7, -2] },
  { id: "action", label: "Action", mapLabel: "ACTION", color: "#9a7344", center: [7, -6, 1] },
  { id: "reasoning", label: "Reasoning", mapLabel: "REASONING", color: "#a06b7b", center: [11, 4, -2] },
  { id: "data", label: "Data", mapLabel: "DATA", color: "#527e69", center: [1, 9, -1] },
  { id: "evaluation", label: "Evaluation", mapLabel: "EVAL", color: "#af6a51", center: [-13, -5, -3] }
];

function mulberry32(seed: number) {
  return () => {
    let value = seed += 0x6d2b79f5;
    value = Math.imul(value ^ value >>> 15, value | 1);
    value ^= value + Math.imul(value ^ value >>> 7, value | 61);
    return ((value ^ value >>> 14) >>> 0) / 4294967296;
  };
}

const random = mulberry32(20260827);
const gaussian = () => {
  const u = Math.max(random(), 0.0001);
  const v = Math.max(random(), 0.0001);
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};

const titleOpeners = [
  "Latent Action Priors", "Embodied Memory", "Cross-Embodiment Transfer", "Open-World Manipulation",
  "Predictive Robot Control", "Language-Grounded Planning", "Visual Foresight", "Scalable Robot Learning",
  "Adaptive Action Chunking", "Compositional Skill Learning", "Long-Horizon Control", "Generative Policy Learning"
];
const titleClosers = [
  "for Generalist Robots", "with Multimodal World Models", "through Self-Supervised Interaction",
  "under Distribution Shift", "from Heterogeneous Demonstrations", "with Closed-Loop Reasoning",
  "across Robot Morphologies", "in Unstructured Environments", "via Hierarchical Representation Learning"
];
const clusterLandmarks: Record<string, string[]> = {
  vla: ["RT-2", "OpenVLA", "π0", "Octo", "RT-X"],
  world: ["DreamerV3", "Genie 2", "V-JEPA", "GAIA-1", "World Models"],
  action: ["Diffusion Policy", "ACT", "RDT-1B", "Gato", "VIMA"],
  reasoning: ["SayCan", "PaLM-E", "Inner Monologue", "ReAct", "VLM-Eval"],
  data: ["Open X-Embodiment", "DROID", "BridgeData V2", "RoboNet", "RH20T"],
  evaluation: ["LIBERO", "CALVIN", "SIMPLER", "ManiSkill", "RoboSuite"]
};
// Mirrors an explicit `atlas_label` in an Obsidian note. No value means no label on the map.
const clusterAtlasLabels: Record<string, string[]> = {
  vla: ["RT2", "OpenVLA", "π0"],
  world: ["Dreamer", "Genie"],
  action: ["Diffusion", "ACT"],
  reasoning: ["SayCan", "PaLME"],
  data: ["OXE", "DROID"],
  evaluation: ["LIBERO", "CALVIN"]
};
const clusterCounts = [34, 32, 31, 31, 30, 38];
const demoNodes: Array<Record<string, unknown>> = [];

clusters.forEach((cluster, clusterIndex) => {
  for (let index = 0; index < clusterCounts[clusterIndex]; index += 1) {
    const radialScale = index === 0 ? 0.2 : 1;
    const secondaryCluster = index === 2 || index === 17 ? clusters[(clusterIndex + 1) % clusters.length] : null;
    const center = secondaryCluster
      ? cluster.center.map((value, axis) => value * 0.68 + secondaryCluster.center[axis] * 0.32)
      : cluster.center;
    const x = center[0] + gaussian() * 2.55 * radialScale;
    const y = center[1] + gaussian() * 2.05 * radialScale;
    const z = center[2] + gaussian() * 1.5 * radialScale;
    const displayName = clusterLandmarks[cluster.id]?.[index];
    const title = displayName
      ? displayName
      : `${titleOpeners[(index + clusterIndex * 3) % titleOpeners.length]} ${titleClosers[(index * 2 + clusterIndex) % titleClosers.length]}`;

    demoNodes.push({
      id: `demo-${cluster.id}-${index}`,
      title,
      atlasLabel: clusterAtlasLabels[cluster.id]?.[index] || "",
      cardHtml: title === "OpenVLA"
        ? '<figure><img src="/images/openvla-overview.png" alt="OpenVLA architecture overview" loading="lazy" decoding="async"><figcaption>OpenVLA · architecture overview</figcaption></figure>'
        : "",
      cardImageCount: title === "OpenVLA" ? 1 : 0,
      hasEssay: index === 1 && ["vla", "world", "reasoning"].includes(cluster.id),
      cluster: cluster.id,
      clusterLabel: cluster.label,
      fields: secondaryCluster ? [cluster.id, secondaryCluster.id] : [cluster.id],
      fieldLabels: secondaryCluster ? [cluster.label, secondaryCluster.label] : [cluster.label],
      secondaryColor: secondaryCluster?.color || "",
      color: cluster.color,
      x,
      y,
      z,
      size: index === 0 ? 0.82 : 0.26 + random() * 0.36,
      year: 2021 + Math.floor(random() * 6),
      kind: "context",
      demo: true,
      fieldMode: "demo",
      phase: random() * Math.PI * 2
    });
  }
});

const previewReadTitles = [
  "Reading Signal / Embodied Transfer",
  "Reading Signal / Closed-Loop Reasoning",
  "Reading Signal / Open-World Control",
  "Reading Signal / Scalable Interaction Data"
];
const previewClusterIds = ["vla", "reasoning", "vla", "data"];
const previewReadSignals = previewReadTitles.map((title, index) => {
  const cluster = clusters.find((item) => item.id === previewClusterIds[index]) ?? clusters[0];
  const angle = (index / previewReadTitles.length) * Math.PI * 2;
  return {
    id: `preview-read-${index}`,
    title,
    atlasLabel: "",
    hasEssay: index === 0 || index === 2,
    cluster: cluster.id,
    clusterLabel: cluster.label,
    fields: [cluster.id],
    fieldLabels: [cluster.label],
    color: "#dffaff",
    accent: cluster.color,
    x: cluster.center[0] + Math.cos(angle) * 1.15,
    y: cluster.center[1] + Math.sin(angle) * 1.15,
    z: cluster.center[2] + 1.1,
    size: 1.02 + index * 0.035,
    year: 2026,
    kind: "preview",
    demo: true,
    fieldMode: "demo",
    phase: index * 1.7
  };
});

const demoFieldNodes = [...demoNodes, ...previewReadSignals];
const demoNodeById = new Map(demoFieldNodes.map((node) => [String(node.id), node]));
const demoEdges: Array<{ source: string; target: string; kind: string; fieldMode: string }> = [];

clusters.forEach((cluster) => {
  const members = demoFieldNodes.filter((node) => Array.isArray(node.fields) ? node.fields.includes(cluster.id) : node.cluster === cluster.id);
  const anchor = members.find((node) => String(node.id).endsWith("-0")) ?? members[0];
  members.forEach((node, index) => {
    if (node.id === anchor.id) return;
    if (index < 12 || random() > 0.62) demoEdges.push({ source: String(anchor.id), target: String(node.id), kind: "field", fieldMode: "demo" });
    if (index > 1) demoEdges.push({ source: String(members[index - 1].id), target: String(node.id), kind: "citation", fieldMode: "demo" });
    if (index > 5 && random() > 0.55) {
      const target = members[Math.floor(random() * index)];
      demoEdges.push({ source: String(node.id), target: String(target.id), kind: "citation", fieldMode: "demo" });
    }
  });
});

for (let index = 0; index < clusters.length; index += 1) {
  const current = `demo-${clusters[index].id}-0`;
  const next = `demo-${clusters[(index + 1) % clusters.length].id}-0`;
  demoEdges.push({ source: current, target: next, kind: "cross-field", fieldMode: "demo" });
}

previewReadSignals.forEach((node, index) => {
  demoEdges.push({ source: node.id, target: `demo-${node.cluster}-0`, kind: "preview", fieldMode: "demo" });
  const nearby = demoNodes.filter((candidate) => candidate.cluster === node.cluster)[3 + index * 2];
  if (nearby) demoEdges.push({ source: node.id, target: String(nearby.id), kind: "preview", fieldMode: "demo" });
});

const personalRandom = mulberry32(260826);
const personalGaussian = () => {
  const u = Math.max(personalRandom(), 0.0001);
  const v = Math.max(personalRandom(), 0.0001);
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};

const clusterForTopic = (topic: string) => {
  const value = topic.toLowerCase();
  if (/(world|dynamics|predict)/.test(value)) return "world";
  if (/(action|diffusion|chunk|policy|control|replan|trajectory)/.test(value)) return "action";
  if (/(reason|plan|language|memory)/.test(value)) return "reasoning";
  if (/(data|scale|dataset|demonstration)/.test(value)) return "data";
  if (/(eval|sim|benchmark|libero|calvin)/.test(value)) return "evaluation";
  return "vla";
};

const personalPapers = researchGraph.nodes.filter((node) => node.type === "paper");
const personalNodes = personalPapers.map((node, index) => {
  const seed = [...node.id].reduce((value, char) => Math.imul(value, 31) + char.charCodeAt(0) | 0, 7);
  const stableRandom = mulberry32(seed);
  const fieldIds = [...new Set((node.topics?.length ? node.topics : ["vla"]).map(clusterForTopic))];
  const primaryCluster = clusters.find((cluster) => cluster.id === fieldIds[0]) ?? clusters[0];
  const secondaryCluster = clusters.find((cluster) => cluster.id === fieldIds[1]);
  const center = secondaryCluster
    ? primaryCluster.center.map((value, axis) => value * 0.72 + secondaryCluster.center[axis] * 0.28)
    : primaryCluster.center;
  const spread = 1.45;
  const maturity = typeof node.maturity === "number" ? node.maturity : 35;

  return {
    id: node.id,
    title: node.title,
    atlasLabel: node.atlasLabel || "",
    hasEssay: false,
    cluster: primaryCluster.id,
    clusterLabel: primaryCluster.label,
    fields: fieldIds,
    fieldLabels: fieldIds.map((id) => clusters.find((cluster) => cluster.id === id)?.label ?? id.toUpperCase()),
    secondaryColor: secondaryCluster?.color || "",
    color: primaryCluster.color,
    accent: primaryCluster.color,
    x: center[0] + (stableRandom() - 0.5) * spread * 4,
    y: center[1] + (stableRandom() - 0.5) * spread * 4,
    z: center[2] + (stableRandom() - 0.5) * spread,
    size: 0.94 + maturity * 0.0034,
    maturity,
    year: node.year,
    kind: "personal",
    noteType: node.type,
    status: node.status,
    readingLevel: node.readingLevel,
    sourceUrl: node.sourceUrl,
    zoteroUri: node.zoteroUri,
    cardHtml: node.atlasCardHtml,
    cardImageCount: node.atlasCardImages,
    fieldMode: "personal",
    phase: personalRandom() * Math.PI * 2 + index * 0.03
  };
});

const personalPaperIds = new Set(personalNodes.map((node) => String(node.id)));
const personalRelationKeys = new Set<string>();
const personalEdges: Array<{ source: string; target: string; kind: string; fieldMode: string }> = [];

const addPersonalRelation = (source: string, target: string, kind: string) => {
  if (source === target || !personalPaperIds.has(source) || !personalPaperIds.has(target)) return;
  const [first, second] = [source, target].sort();
  const key = `${first}::${second}`;
  if (personalRelationKeys.has(key)) return;
  personalRelationKeys.add(key);
  personalEdges.push({ source: first, target: second, kind, fieldMode: "personal" });
};

researchGraph.edges.forEach((edge) => addPersonalRelation(edge.source, edge.target, "manual"));
researchGraph.nodes
  .filter((node) => node.type === "field" || node.type === "concept")
  .forEach((connector) => {
    const relatedPapers = researchGraph.edges.flatMap((edge) => {
      if (edge.source === connector.id && personalPaperIds.has(edge.target)) return [edge.target];
      if (edge.target === connector.id && personalPaperIds.has(edge.source)) return [edge.source];
      return [];
    });
    for (let sourceIndex = 0; sourceIndex < relatedPapers.length; sourceIndex += 1) {
      for (let targetIndex = sourceIndex + 1; targetIndex < relatedPapers.length; targetIndex += 1) {
        addPersonalRelation(relatedPapers[sourceIndex], relatedPapers[targetIndex], connector.type === "field" ? "shared-field" : "shared-concept");
      }
    }
  });

const nodes = [...demoFieldNodes, ...personalNodes];
const nodeById = new Map(nodes.map((node) => [String(node.id), node]));
const edges = [
  ...demoEdges.filter((edge) => demoNodeById.has(edge.source) && demoNodeById.has(edge.target)),
  ...personalEdges
];

const atlasData = {
  nodes,
  edges: edges.filter((edge) => nodeById.has(edge.source) && nodeById.has(edge.target)),
  clusters,
  counts: {
    demo: demoFieldNodes.length,
    personal: personalNodes.length
  }
};
const atlasJson = JSON.stringify(atlasData).replaceAll("<", "\\u003c");
const fallbackDots = personalNodes.slice(0, 150).map((node) => ({
  id: node.id,
  title: node.title,
  label: node.atlasLabel,
  left: Math.min(96, Math.max(4, 50 + Number(node.x) * 2.7)),
  top: Math.min(94, Math.max(6, 50 - Number(node.y) * 3.4)),
  size: Number(node.size) * 7,
  color: `var(--atlas-${node.cluster})`
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeHead />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://txtxx.me/atlas/" />
    <title>ATLAS / TxTxx</title>
    <meta name="description" content="TxTxx 的论文收藏与公开阅读笔记。" />
  </head>
  <body>
    <main class="atlas" data-atlas data-field-mode="personal">
      <div class="fallback-field">
        {fallbackDots.map((dot) => <button class="fallback-dot" type="button" data-fallback-node={dot.id} aria-label={dot.title} style={`--x:${dot.left}%;--y:${dot.top}%;--s:${dot.size}px;--c:${dot.color}`}><i></i>{dot.label && <span>{dot.label}</span>}</button>)}
      </div>
      <div class="webgl-mount" data-webgl-mount aria-label="Interactive research constellation"></div>
      <div class="grain" aria-hidden="true"></div>
      <div class="vignette" aria-hidden="true"></div>

      <header class="atlas-mark">
        <a href="/" aria-label="返回 TxTxx 网站">TX</a>
        <span></span>
        <b>Atlas <small>阅读图谱</small></b>
      </header>

      <div class="atlas-tools">
        <ThemeToggle />
        <button type="button" data-reset aria-label="将图谱归位">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /><circle cx="12" cy="12" r="3" /></svg>
          <span>归位</span>
        </button>
      </div>

      <div class="cluster-legend" aria-label="Research fields">
        {clusters.map((cluster) => <button type="button" data-cluster={cluster.id} aria-pressed="false"><i style={`--c:var(--atlas-${cluster.id})`}></i>{cluster.label}</button>)}
      </div>

      <div class="field-status">
        <div class="field-switch" aria-label="Atlas data field">
          <button type="button" data-field-mode="personal" aria-pressed="true">我的论文</button>
          <i aria-hidden="true"></i>
          <button type="button" data-field-mode="demo" aria-pressed="false">演示</button>
        </div>
        <b data-node-count>{personalNodes.length} 篇</b>
      </div>

      <div class="label-layer" data-label-layer></div>

      <div class="hover-label" data-hover-label hidden>
        <span data-hover-index></span>
        <strong data-hover-title></strong>
      </div>

      <aside class="focus-card" data-focus-card hidden>
        <button type="button" class="focus-close" data-focus-close aria-label="关闭">×</button>
        <span class="focus-kind" data-focus-kind></span>
        <h1 data-focus-title></h1>
        <div class="focus-meta">
          <span data-focus-year></span>
          <span data-focus-cluster></span>
        </div>
        <div class="focus-relations" data-focus-relations hidden></div>
        <div class="focus-body" data-focus-body hidden></div>
        <div class="focus-actions">
          <a data-focus-source target="_blank" rel="noreferrer" hidden>原文 ↗</a>
          <a data-focus-zotero hidden>Zotero ↗</a>
        </div>
      </aside>

      <div class="media-lightbox" data-media-lightbox hidden>
        <button type="button" data-media-close aria-label="关闭图片">×</button>
        <img data-media-image alt="" />
      </div>

      <div class="loading-mark" data-loading><i></i><span>载入图谱</span></div>
      <script id="atlas-data" type="application/json" set:html={atlasJson}></script>
    </main>

    <script>
      import * as THREE from "three";
      import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";

      const atlas = document.querySelector("[data-atlas]");
      const mount = document.querySelector("[data-webgl-mount]");
      const dataElement = document.querySelector("#atlas-data");
      const loading = document.querySelector("[data-loading]");
      const tooltip = document.querySelector("[data-hover-label]");
      const focusCard = document.querySelector("[data-focus-card]");
      const focusBody = document.querySelector("[data-focus-body]");
      const mediaLightbox = document.querySelector("[data-media-lightbox]");
      const mediaImage = document.querySelector("[data-media-image]");
      const mediaClose = document.querySelector("[data-media-close]");
      const reset = document.querySelector("[data-reset]");
      const closeFocus = document.querySelector("[data-focus-close]");
      const clusterButtons = Array.from(document.querySelectorAll("[data-cluster]"));
      const fieldModeButtons = Array.from(document.querySelectorAll("[data-field-mode]"));
      const nodeCount = document.querySelector("[data-node-count]");
      const labelLayer = document.querySelector("[data-label-layer]");
      const data = dataElement ? JSON.parse(dataElement.textContent || "{}") : { nodes: [], edges: [], clusters: [] };
      const dataById = new Map(data.nodes.map((node) => [node.id, node]));
      const colorByCluster = new Map(data.clusters.map((cluster) => [cluster.id, cluster.color]));
      let activeFieldMode = "personal";
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Both the interactive graph and static fallback read the same exported paper data.
      const populateCard = (node) => {
        setText("[data-focus-kind]", node.kind === "personal" ? "我的论文" : "演示数据");
        setText("[data-focus-title]", node.title);
        setText("[data-focus-year]", node.year ? String(node.year) : "年份未标注");
        setText("[data-focus-cluster]", node.fieldLabels?.join(" · ") || node.clusterLabel);
        for (const [selector, url] of [["[data-focus-source]", node.sourceUrl], ["[data-focus-zotero]", node.zoteroUri]]) {
          const link = document.querySelector(selector);
          link?.toggleAttribute("hidden", !url);
          if (url) link.href = url;
        }
        focusBody.hidden = !node.cardHtml;
        focusBody.innerHTML = node.cardHtml || "";
        const relationBox = document.querySelector("[data-focus-relations]");
        relationBox.replaceChildren();
        const relations = data.edges.filter(edge => edge.fieldMode === activeFieldMode && (edge.source === node.id || edge.target === node.id));
        relationBox.hidden = !relations.length;
        const labels = { manual: "笔记关联", "shared-field": "共同领域", "shared-concept": "共同概念" };
        for (const edge of relations.slice(0, 8)) {
          const related = dataById.get(edge.source === node.id ? edge.target : edge.source);
          if (!related) continue;
          const button = document.createElement("button");
          button.type = "button";
          button.textContent = `${labels[edge.kind] || "演示关联"} · ${related.atlasLabel || related.title}`;
          button.addEventListener("click", () => focusNode(related.id));
          relationBox.appendChild(button);
        }
      };
      let focusNode = (id) => {
        const node = dataById.get(id);
        if (!node) return;
        populateCard(node);
        focusCard.hidden = false;
        requestAnimationFrame(() => focusCard.classList.add("is-open"));
      };
      const setText = (selector, value) => {
        const element = document.querySelector(selector);
        if (element) element.textContent = value || "—";
      };
      document.querySelectorAll("[data-fallback-node]").forEach(button => {
        button.addEventListener("click", () => focusNode(button.dataset.fallbackNode));
      });

      const makeGlowTexture = () => {
        const canvas = document.createElement("canvas");
        canvas.width = 128;
        canvas.height = 128;
        const context = canvas.getContext("2d");
        const gradient = context.createRadialGradient(64, 64, 0, 64, 64, 64);
        gradient.addColorStop(0, "rgba(255,255,255,0.12)");
        gradient.addColorStop(0.45, "rgba(255,255,255,0.08)");
        gradient.addColorStop(1, "rgba(255,255,255,0)");
        context.fillStyle = gradient;
        context.fillRect(0, 0, 128, 128);
        context.beginPath();
        context.arc(64, 64, 21, 0, Math.PI * 2);
        context.fillStyle = "#ffffff";
        context.fill();
        context.beginPath();
        context.arc(64, 64, 39, 0, Math.PI * 2);
        context.strokeStyle = "rgba(255,255,255,0.32)";
        context.lineWidth = 1.8;
        context.stroke();
        const texture = new THREE.CanvasTexture(canvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        return texture;
      };

      const makeLabelTexture = (label, glowColor) => {
        const probe = document.createElement("canvas");
        const probeContext = probe.getContext("2d");
        const font = '500 54px "SFMono-Regular", Menlo, Consolas, monospace';
        probeContext.font = font;
        const width = Math.ceil(Math.min(720, Math.max(150, probeContext.measureText(label).width + 68)));
        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = 96;
        const context = canvas.getContext("2d");
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.font = font;
        context.textAlign = "center";
        context.textBaseline = "middle";
        context.fillStyle = "#ffffff";
        context.fillText(label, canvas.width / 2, canvas.height / 2 + 1);
        const texture = new THREE.CanvasTexture(canvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        texture.minFilter = THREE.LinearFilter;
        texture.magFilter = THREE.LinearFilter;
        texture.generateMipmaps = false;
        return { texture, aspect: canvas.width / canvas.height };
      };

      if (atlas && mount && data.nodes.length) {
        try {
          const scene = new THREE.Scene();
          scene.fog = new THREE.FogExp2(0xf6f4ef, 0.003);

          const camera = new THREE.PerspectiveCamera(46, window.innerWidth / window.innerHeight, 0.1, 150);
          camera.position.set(0, 0.5, 34);

          const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "default" });
          renderer.setClearColor(0xf6f4ef, 0);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.8));
          renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.outputColorSpace = THREE.SRGBColorSpace;
          renderer.toneMapping = THREE.NoToneMapping;
          renderer.toneMappingExposure = 1;
          mount.appendChild(renderer.domElement);

          const controls = new OrbitControls(camera, renderer.domElement);
          controls.enableDamping = true;
          controls.dampingFactor = 0.045;
          controls.enablePan = true;
          controls.screenSpacePanning = true;
          controls.panSpeed = 0.42;
          controls.minDistance = 7;
          controls.maxDistance = 58;
          controls.rotateSpeed = 0.22;
          controls.zoomSpeed = 0.65;
          controls.autoRotate = false;
          controls.autoRotateSpeed = 0.12;

          const universe = new THREE.Group();
          scene.add(universe);
          const glowTexture = makeGlowTexture();
          const sprites = [];
          const spriteById = new Map();
          const spritesByField = new Map([["demo", []], ["personal", []]]);

          const baseNodeOpacity = (node) => node.kind === "personal"
            ? 0.86 + Math.min(100, Math.max(0, Number(node.maturity) || 0)) * 0.0014
            : node.kind === "preview" ? 0.74 : node.atlasLabel ? 0.72 : 0.58;

          data.nodes.forEach((node) => {
            const initialOpacity = node.fieldMode === activeFieldMode ? baseNodeOpacity(node) : 0;
            const material = new THREE.SpriteMaterial({
              map: glowTexture,
              color: new THREE.Color(node.color),
              transparent: true,
              opacity: initialOpacity,
              blending: THREE.NormalBlending,
              depthWrite: false
            });
            const sprite = new THREE.Sprite(material);
            sprite.position.set(node.x, node.y, node.z);
            sprite.scale.setScalar(node.size);
            sprite.userData = {
              ...node,
              basePosition: sprite.position.clone(),
              baseScale: node.size,
              baseOpacity: baseNodeOpacity(node),
              targetOpacity: initialOpacity,
              targetScale: node.size
            };
            universe.add(sprite);
            sprites.push(sprite);
            spriteById.set(node.id, sprite);
            spritesByField.get(node.fieldMode)?.push(sprite);

            if (node.atlasLabel && node.kind !== "personal") {
              const labelTexture = makeLabelTexture(node.atlasLabel, node.color);
              const labelMaterial = new THREE.SpriteMaterial({
                map: labelTexture.texture,
                color: new THREE.Color(node.color),
                transparent: true,
                opacity: node.fieldMode === activeFieldMode ? 0.62 : 0,
                blending: THREE.NormalBlending,
                depthTest: true,
                depthWrite: false,
                fog: true,
                toneMapped: false
              });
              const labelSprite = new THREE.Sprite(labelMaterial);
              const labelHeight = 0.26;
              const offsetY = node.size * 0.18 + 0.12;
              labelSprite.scale.set(labelHeight * labelTexture.aspect, labelHeight, 1);
              labelSprite.position.copy(sprite.position);
              labelSprite.position.y += offsetY;
              labelSprite.renderOrder = 3;
              labelSprite.userData = { parentNode: node.id, offsetY, baseOpacity: node.fieldMode === activeFieldMode ? 0.54 : 0 };
              universe.add(labelSprite);
              sprite.userData.labelSprite = labelSprite;
            }

            if (Array.isArray(node.fields) && node.fields.length > 1 && node.secondaryColor) {
              const fieldRingMaterial = new THREE.MeshBasicMaterial({
                color: new THREE.Color(node.secondaryColor),
                transparent: true,
                opacity: node.fieldMode === activeFieldMode ? 0.2 : 0,
                blending: THREE.NormalBlending,
                depthWrite: false,
                side: THREE.DoubleSide
              });
              const fieldRing = new THREE.Mesh(new THREE.RingGeometry(node.size * 0.68, node.size * 0.73, 64), fieldRingMaterial);
              fieldRing.position.copy(sprite.position);
              fieldRing.userData = { parentNode: node.id, targetOpacity: node.fieldMode === activeFieldMode ? 0.2 : 0 };
              universe.add(fieldRing);
              sprite.userData.fieldRing = fieldRing;
            }

            if (node.kind === "preview" || node.kind === "personal") {
              const interactionOnly = node.kind === "personal";
              const ringMaterial = new THREE.MeshBasicMaterial({
                color: new THREE.Color(node.accent || "#ffffff"),
                transparent: true,
                opacity: interactionOnly ? 0 : node.fieldMode === activeFieldMode ? 0.3 : 0,
                blending: THREE.NormalBlending,
                depthWrite: false,
                side: THREE.DoubleSide
              });
              const ring = new THREE.Mesh(new THREE.RingGeometry(node.size * 0.56, node.size * 0.62, 64), ringMaterial);
              ring.position.copy(sprite.position);
              ring.userData = {
                parentNode: node.id,
                interactionOnly,
                targetOpacity: interactionOnly ? 0 : node.fieldMode === activeFieldMode ? 0.3 : 0
              };
              universe.add(ring);
              sprite.userData.ring = ring;
            }
          });

          const edgeFields = new Map();
          ["demo", "personal"].forEach((fieldMode) => {
            const linePositions = [];
            data.edges.filter((edge) => edge.fieldMode === fieldMode).forEach((edge) => {
              const source = dataById.get(edge.source);
              const target = dataById.get(edge.target);
              if (!source || !target) return;
              linePositions.push(source.x, source.y, source.z, target.x, target.y, target.z);
            });
            const lineGeometry = new THREE.BufferGeometry();
            lineGeometry.setAttribute("position", new THREE.Float32BufferAttribute(linePositions, 3));
            const initialOpacity = fieldMode === activeFieldMode ? 0.2 : 0;
            const lineMaterial = new THREE.LineBasicMaterial({ color: fieldMode === "personal" ? 0x718b91 : 0x89999d, transparent: true, opacity: initialOpacity, blending: THREE.NormalBlending, depthWrite: false });
            const edgeField = new THREE.LineSegments(lineGeometry, lineMaterial);
            edgeField.userData.targetOpacity = initialOpacity;
            universe.add(edgeField);
            edgeFields.set(fieldMode, edgeField);
          });

          const raycaster = new THREE.Raycaster();
          const pointer = new THREE.Vector2(4, 4);
          const pointerTarget = new THREE.Vector2();
          let hovered = null;
          let selected = null;
          let activeCluster = null;
          let cameraTransition = null;
          let cardHideTimer = null;
          let highlightedLines = null;
          let pointerDown = null;
          let returnCamera = null;

          // Only update presentation materials: preserve graph data, camera and selection.
          const applyAtlasTheme = () => {
            const style = getComputedStyle(document.documentElement);
            const background = style.getPropertyValue("--atlas-bg").trim();
            scene.fog.color.set(background);
            renderer.setClearColor(background, 0);
            data.clusters.forEach(cluster => {
              colorByCluster.set(cluster.id, style.getPropertyValue(`--atlas-${cluster.id}`).trim());
            });
            sprites.forEach(sprite => {
              const node = sprite.userData;
              const primary = colorByCluster.get(node.cluster);
              sprite.material.color.set(primary);
              node.labelSprite?.material.color.set(primary);
              node.ring?.material.color.set(primary);
              node.fieldRing?.material.color.set(colorByCluster.get(node.fields?.[1]) || primary);
            });
            edgeFields.forEach(edgeField => {
              edgeField.material.color.set(style.getPropertyValue("--atlas-muted").trim());
            });
            if (highlightedLines && selected) {
              highlightedLines.material.color.set(colorByCluster.get(dataById.get(selected)?.cluster));
            }
          };
          const paperLabelElements = new Map();
          data.nodes.filter(node => node.kind === "personal" && node.atlasLabel).forEach(node => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "paper-map-label";
            button.style.setProperty("--node-color", `var(--atlas-${node.cluster})`);
            button.setAttribute("aria-label", node.title);
            const title = document.createElement("strong");
            title.textContent = node.atlasLabel || node.title;
            button.append(title);
            button.addEventListener("click", () => focusNode(node.id));
            labelLayer.appendChild(button);
            paperLabelElements.set(node.id, button);
          });

          const clusterLabelElements = new Map();
          data.clusters.forEach((cluster) => {
            const element = document.createElement("span");
            element.className = "cluster-label";
            element.textContent = cluster.mapLabel || cluster.label;
            element.style.setProperty("--label-color", `var(--atlas-${cluster.id})`);
            labelLayer.appendChild(element);
            clusterLabelElements.set(cluster.id, element);
          });

          const connectedIds = (nodeId) => {
            const ids = new Set([nodeId]);
            data.edges.forEach((edge) => {
              if (edge.fieldMode !== activeFieldMode) return;
              if (edge.source === nodeId) ids.add(edge.target);
              if (edge.target === nodeId) ids.add(edge.source);
            });
            return ids;
          };

          const belongsToCluster = (node, clusterId) => Array.isArray(node.fields)
            ? node.fields.includes(clusterId)
            : node.cluster === clusterId;

          const activeNodes = () => data.nodes.filter((node) => node.fieldMode === activeFieldMode);

          const fitField = (animated = true) => {
            const members = activeNodes().filter(node => !activeCluster || belongsToCluster(node, activeCluster));
            if (!members.length) return;
            const bounds = new THREE.Box3();
            members.forEach(node => bounds.expandByPoint(new THREE.Vector3(node.x, node.y, node.z)));
            const center = bounds.getCenter(new THREE.Vector3());
            const size = bounds.getSize(new THREE.Vector3());
            const tangent = Math.tan(THREE.MathUtils.degToRad(camera.fov / 2));
            const distance = Math.min(58, Math.max(12, (Math.max((size.y + 5) / tangent, (size.x + 10) / (tangent * camera.aspect)) / 2 + size.z) * 1.1));
            const position = center.clone().add(new THREE.Vector3(0, 0, distance));
            universe.rotation.set(0, 0, 0);
            if (animated && !reducedMotion) moveCameraTo(position, center, 500);
            else { camera.position.copy(position); controls.target.copy(center); camera.lookAt(center); controls.update(); }
          };

          const scopeIds = () => activeCluster
            ? new Set(activeNodes().filter((node) => belongsToCluster(node, activeCluster)).map((node) => node.id))
            : null;

          const updateNodeOpacity = (activeIds = null) => {
            sprites.forEach((sprite) => {
              const isInField = sprite.userData.fieldMode === activeFieldMode;
              const isActive = isInField && (!activeIds || activeIds.has(sprite.userData.id));
              sprite.userData.targetOpacity = !isInField ? 0 : isActive ? sprite.userData.baseOpacity : 0.045;
              sprite.userData.targetScale = sprite.userData.baseScale * (sprite.userData.id === selected ? 1.24 : 1);
              if (sprite.userData.ring && !sprite.userData.ring.userData.interactionOnly) {
                sprite.userData.ring.userData.targetOpacity = !isInField ? 0 : isActive ? 0.3 : 0.025;
              }
              if (sprite.userData.fieldRing) sprite.userData.fieldRing.userData.targetOpacity = !isInField ? 0 : isActive ? 0.2 : 0.015;
              if (sprite.userData.labelSprite) {
                sprite.userData.labelSprite.userData.baseOpacity = !isInField ? 0 : isActive ? (sprite.userData.id === selected ? 0.82 : 0.54) : 0.02;
              }
            });
            edgeFields.forEach((edgeField, fieldMode) => {
              edgeField.userData.targetOpacity = fieldMode === activeFieldMode ? (fieldMode === "personal" ? 0.28 : 0.13) : 0;
            });
          };

          const refreshFieldInterface = () => {
            const currentNodes = activeNodes();
            const availableClusters = new Set(currentNodes.flatMap((node) => Array.isArray(node.fields) ? node.fields : [node.cluster]));
            fieldModeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.fieldMode === activeFieldMode)));
            clusterButtons.forEach((button) => {
              button.hidden = !availableClusters.has(button.dataset.cluster);
              button.setAttribute("aria-pressed", "false");
            });
            if (nodeCount) nodeCount.textContent = `${currentNodes.length} ${activeFieldMode === "personal" ? "篇" : "个演示节点"}`;
            atlas.dataset.fieldMode = activeFieldMode;
          };

          const openFocusCard = () => {
            if (cardHideTimer) window.clearTimeout(cardHideTimer);
            focusCard.hidden = false;
            requestAnimationFrame(() => focusCard.classList.add("is-open"));
          };

          const hideFocusCard = () => {
            focusCard.classList.remove("is-open");
            if (cardHideTimer) window.clearTimeout(cardHideTimer);
            cardHideTimer = window.setTimeout(() => { focusCard.hidden = true; }, 340);
          };

          const closeMedia = () => {
            if (!mediaLightbox || mediaLightbox.hidden) return;
            mediaLightbox.classList.remove("is-open");
            window.setTimeout(() => {
              mediaLightbox.hidden = true;
              if (mediaImage) mediaImage.removeAttribute("src");
            }, 220);
          };

          const openMedia = (image) => {
            if (!mediaLightbox || !mediaImage || !image?.src) return;
            mediaImage.src = image.currentSrc || image.src;
            mediaImage.alt = image.alt || "Atlas card image";
            mediaLightbox.hidden = false;
            requestAnimationFrame(() => mediaLightbox.classList.add("is-open"));
          };

          const updateFocusBody = (node) => {
            if (!focusBody) return;
            const hasCard = Boolean(node.cardHtml);
            focusCard.classList.toggle("has-content", hasCard);
            focusBody.hidden = !hasCard;
            focusBody.innerHTML = hasCard ? node.cardHtml : "";
            focusBody.querySelectorAll("img").forEach((image) => {
              image.tabIndex = 0;
              image.setAttribute("role", "button");
              image.setAttribute("aria-label", image.alt ? `查看大图：${image.alt}` : "查看大图");
            });
          };

          const easeInOutCubic = (value) => value < 0.5
            ? 4 * value * value * value
            : 1 - Math.pow(-2 * value + 2, 3) / 2;

          const cancelCameraTransition = () => {
            if (!cameraTransition) return;
            cameraTransition = null;
            controls.enabled = true;
          };

          const syncControls = () => {
            const damping = controls.enableDamping;
            controls.enableDamping = false;
            controls.update();
            controls.enableDamping = damping;
          };

          const moveCameraTo = (position, target, duration = 820, onComplete = null, path = "linear", orbitArc = 0) => {
            syncControls();
            const fromSpherical = new THREE.Spherical().setFromVector3(camera.position.clone().sub(controls.target)).makeSafe();
            const toSpherical = new THREE.Spherical().setFromVector3(position.clone().sub(target)).makeSafe();
            const rawThetaDelta = toSpherical.theta - fromSpherical.theta;
            const thetaDelta = Math.atan2(Math.sin(rawThetaDelta), Math.cos(rawThetaDelta));
            cameraTransition = {
              startedAt: performance.now(),
              duration,
              path,
              orbitArc,
              orbitDirection: Math.abs(thetaDelta) < 0.001 ? 1 : Math.sign(thetaDelta),
              fromPosition: camera.position.clone(),
              fromTarget: controls.target.clone(),
              toPosition: position.clone(),
              toTarget: target.clone(),
              fromSpherical,
              toSpherical,
              thetaDelta,
              onComplete
            };
            controls.enabled = false;
          };

          const clearHighlightedLines = () => {
            if (!highlightedLines) return;
            universe.remove(highlightedLines);
            highlightedLines.geometry.dispose();
            highlightedLines.material.dispose();
            highlightedLines = null;
          };

          const drawSelectedConnections = (nodeId) => {
            clearHighlightedLines();
            const positions = [];
            const node = dataById.get(nodeId);
            data.edges.forEach((edge) => {
              if (edge.fieldMode !== activeFieldMode) return;
              if (edge.source !== nodeId && edge.target !== nodeId) return;
              const target = dataById.get(edge.source === nodeId ? edge.target : edge.source);
              if (node && target) positions.push(node.x, node.y, node.z, target.x, target.y, target.z);
            });
            if (!positions.length) return;
            const geometry = new THREE.BufferGeometry();
            geometry.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
            const material = new THREE.LineBasicMaterial({ color: new THREE.Color(colorByCluster.get(node.cluster) || "#426f80"), transparent: true, opacity: 0.68, blending: THREE.NormalBlending, depthWrite: false });
            highlightedLines = new THREE.LineSegments(geometry, material);
            universe.add(highlightedLines);
          };

          const showFocus = (nodeId) => {
            const node = dataById.get(nodeId);
            const sprite = spriteById.get(nodeId);
            if (!node || !sprite || node.fieldMode !== activeFieldMode) return;
            if (!selected) returnCamera = { position: camera.position.clone(), target: controls.target.clone() };
            selected = nodeId;
            controls.autoRotate = false;
            updateNodeOpacity(connectedIds(nodeId));
            drawSelectedConnections(nodeId);
            const direction = camera.position.clone().sub(controls.target).normalize();
            universe.updateMatrixWorld(true);
            const nodeTarget = new THREE.Vector3();
            sprite.getWorldPosition(nodeTarget);
            if (!reducedMotion) moveCameraTo(nodeTarget.clone().add(direction.multiplyScalar(16)), nodeTarget, 500);
            populateCard(node);
            updateFocusBody(node);
            openFocusCard();
          };
          focusNode = showFocus;

          const closeSelection = () => {
            cancelCameraTransition();
            selected = null;
            closeMedia();
            hideFocusCard();
            clearHighlightedLines();
            updateNodeOpacity(scopeIds());
            controls.autoRotate = false;
            if (returnCamera) {
              if (reducedMotion) { camera.position.copy(returnCamera.position); controls.target.copy(returnCamera.target); controls.update(); }
              else moveCameraTo(returnCamera.position, returnCamera.target, 450);
            }
            returnCamera = null;
          };

          const resetField = () => {
            cancelCameraTransition();
            selected = null;
            activeCluster = null;
            returnCamera = null;
            closeMedia();
            hideFocusCard();
            clearHighlightedLines();
            updateNodeOpacity();
            controls.autoRotate = false;
            clusterButtons.forEach((button) => button.setAttribute("aria-pressed", "false"));
            fitField();
          };

          const switchField = (nextFieldMode) => {
            if (!(nextFieldMode in (data.counts || {})) || nextFieldMode === activeFieldMode) return;
            cancelCameraTransition();
            selected = null;
            activeCluster = null;
            returnCamera = null;
            activeFieldMode = nextFieldMode;
            closeMedia();
            hovered = null;
            tooltip.hidden = true;
            hideFocusCard();
            clearHighlightedLines();
            updateNodeOpacity();
            refreshFieldInterface();
            controls.autoRotate = false;
            fitField();
          };

          const updatePointer = (event) => {
            pointer.x = event.clientX / window.innerWidth * 2 - 1;
            pointer.y = -(event.clientY / window.innerHeight) * 2 + 1;
            pointerTarget.x = pointer.x;
            pointerTarget.y = pointer.y;
          };

          renderer.domElement.addEventListener("pointermove", (event) => {
            updatePointer(event);
            if (!tooltip.hidden) {
              tooltip.style.left = `${Math.min(window.innerWidth - 290, event.clientX + 18)}px`;
              tooltip.style.top = `${Math.min(window.innerHeight - 90, event.clientY + 18)}px`;
            }
          });
          renderer.domElement.addEventListener("pointerdown", (event) => {
            cancelCameraTransition();
            pointerDown = { x: event.clientX, y: event.clientY };
          }, true);
          renderer.domElement.addEventListener("pointerup", (event) => {
            if (!pointerDown || Math.hypot(event.clientX - pointerDown.x, event.clientY - pointerDown.y) > 6) return;
            updatePointer(event);
            raycaster.setFromCamera(pointer, camera);
            hovered = raycaster.intersectObjects(spritesByField.get(activeFieldMode) || [], false)[0]?.object || null;
            if (hovered) showFocus(hovered.userData.id);
            else if (selected) closeSelection();
          });
          renderer.domElement.addEventListener("pointerleave", () => {
            pointer.set(4, 4);
            hovered = null;
            tooltip.hidden = true;
          });

          reset?.addEventListener("click", resetField);
          closeFocus?.addEventListener("click", closeSelection);
          mediaClose?.addEventListener("click", closeMedia);
          mediaLightbox?.addEventListener("click", (event) => {
            if (event.target === mediaLightbox) closeMedia();
          });
          focusBody?.addEventListener("click", (event) => {
            const image = event.target.closest("img");
            if (image) openMedia(image);
          });
          focusBody?.addEventListener("keydown", (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            const image = event.target.closest("img");
            if (!image) return;
            event.preventDefault();
            openMedia(image);
          });
          fieldModeButtons.forEach((button) => {
            button.addEventListener("click", () => switchField(button.dataset.fieldMode));
          });
          controls.addEventListener("start", () => {
            cancelCameraTransition();
            controls.autoRotate = false;
          });
          window.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            if (mediaLightbox && !mediaLightbox.hidden) {
              closeMedia();
              return;
            }
            if (selected || !focusCard.hidden) closeSelection();
            else if (activeCluster) resetField();
          });

          clusterButtons.forEach((button) => {
            button.addEventListener("click", () => {
              const cluster = data.clusters.find((item) => item.id === button.dataset.cluster);
              if (!cluster) return;
              selected = null;
              activeCluster = activeCluster === cluster.id ? null : cluster.id;
              hideFocusCard();
              clearHighlightedLines();
              const clusterIds = scopeIds();
              updateNodeOpacity(clusterIds);
              controls.autoRotate = false;
              clusterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item.dataset.cluster === activeCluster)));
              fitField();
            });
          });

          applyAtlasTheme();
          document.addEventListener("txtxx:themechange", applyAtlasTheme);
          refreshFieldInterface();
          fitField(false);

          const timer = new THREE.Timer();
          const clusterPosition = new THREE.Vector3();
          const transitionOffset = new THREE.Vector3();
          const transitionSpherical = new THREE.Spherical();

          const updateLabels = () => {
            const width = window.innerWidth;
            const height = window.innerHeight;
            data.clusters.forEach((cluster) => {
              const element = clusterLabelElements.get(cluster.id);
              if (!element) return;
              const hasActiveNodes = (activeFieldMode === "demo" || activeNodes().length > 8) && activeNodes().some((node) => belongsToCluster(node, cluster.id));
              if (!hasActiveNodes) {
                element.classList.remove("visible");
                return;
              }
              clusterPosition.set(...cluster.center).applyMatrix4(universe.matrixWorld).project(camera);
              const x = (clusterPosition.x * 0.5 + 0.5) * width;
              const y = (-clusterPosition.y * 0.5 + 0.5) * height;
              const visible = clusterPosition.z > -1 && clusterPosition.z < 1 && x > 70 && x < width - 70 && y > 85 && y < height - 70;
              element.classList.toggle("visible", visible);
              if (visible) element.style.transform = `translate3d(${x}px, ${y - 27}px, 0)`;
            });
            const occupied = [];
            const labelNodes = activeNodes().filter(node => node.kind === "personal" && node.atlasLabel)
              .sort((a, b) => Number(b.id === selected) - Number(a.id === selected));
            paperLabelElements.forEach((element) => { element.hidden = true; });
            for (const node of labelNodes) {
              if (activeCluster && !belongsToCluster(node, activeCluster)) continue;
              const sprite = spriteById.get(node.id);
              const element = paperLabelElements.get(node.id);
              const world = sprite.getWorldPosition(new THREE.Vector3());
              const distance = camera.position.distanceTo(world);
              if (labelNodes.length > 12 && distance > 28 && node.id !== selected && hovered !== sprite) continue;
              const projected = world.project(camera);
              const anchorX = (projected.x * 0.5 + 0.5) * width;
              const y = (-projected.y * 0.5 + 0.5) * height + 22;
              if (projected.z < -1 || projected.z > 1 || anchorX < 30 || anchorX > width - 30 || y < 110 || y > height - 130) continue;
              const labelWidth = Math.min(190, Math.max(100, node.atlasLabel.length * 13 + 28));
              const x = Math.max(16, Math.min(width - labelWidth - 16, anchorX - labelWidth / 2));
              const rect = { x, y, right: x + labelWidth, bottom: y + 42 };
              if (occupied.some(box => rect.x < box.right && rect.right > box.x && rect.y < box.bottom && rect.bottom > box.y)) continue;
              occupied.push(rect);
              element.hidden = false;
              element.style.width = `${labelWidth}px`;
              element.style.transform = `translate3d(${x}px, ${y}px, 0)`;
              element.setAttribute("aria-pressed", String(node.id === selected));
            }
          };

          const animate = () => {
            requestAnimationFrame(animate);
            if (document.hidden) return;
            timer.update();
            const elapsed = timer.getElapsed();
            raycaster.setFromCamera(pointer, camera);
            const intersections = raycaster.intersectObjects(spritesByField.get(activeFieldMode) || [], false);
            const nextHovered = intersections[0]?.object ?? null;
            if (nextHovered !== hovered) {
              hovered = nextHovered;
              tooltip.hidden = !hovered;
              renderer.domElement.style.cursor = hovered ? "pointer" : "grab";
              if (hovered) {
                setText("[data-hover-index]", hovered.userData.kind === "personal" ? "PERSONAL" : hovered.userData.kind === "preview" ? "DEMO READ" : hovered.userData.clusterLabel);
                setText("[data-hover-title]", hovered.userData.title);
              }
            }

            sprites.forEach((sprite) => {
              const base = sprite.userData.basePosition;
              sprite.material.opacity += (sprite.userData.targetOpacity - sprite.material.opacity) * 0.12;
              const nextScale = sprite.scale.x + (sprite.userData.targetScale - sprite.scale.x) * 0.12;
              sprite.scale.setScalar(nextScale);
              if (!reducedMotion && controls.autoRotate && sprite.userData.id !== selected) {
                sprite.position.y = base.y + Math.sin(elapsed * 0.27 + sprite.userData.phase) * 0.035;
              }
              if (sprite.userData.ring) {
                if (sprite.userData.ring.userData.interactionOnly) {
                  const isInField = sprite.userData.fieldMode === activeFieldMode;
                  sprite.userData.ring.userData.targetOpacity = !isInField
                    ? 0
                    : sprite.userData.id === selected
                      ? 0.3
                      : hovered === sprite ? 0.18 : 0;
                }
                sprite.userData.ring.position.copy(sprite.position);
                sprite.userData.ring.rotation.z = elapsed * 0.08 + sprite.userData.phase;
                sprite.userData.ring.material.opacity += (sprite.userData.ring.userData.targetOpacity - sprite.userData.ring.material.opacity) * 0.12;
              }
              if (sprite.userData.fieldRing) {
                sprite.userData.fieldRing.position.copy(sprite.position);
                sprite.userData.fieldRing.rotation.z = -elapsed * 0.055 + sprite.userData.phase;
                sprite.userData.fieldRing.material.opacity += (sprite.userData.fieldRing.userData.targetOpacity - sprite.userData.fieldRing.material.opacity) * 0.12;
              }
              if (sprite.userData.labelSprite) {
                const labelSprite = sprite.userData.labelSprite;
                labelSprite.position.copy(sprite.position);
