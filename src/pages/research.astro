---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutProfile, selectedWorks } from "../data/profile";
---

<BaseLayout title="Research | TxTxx" description="Research profile" pathname="/research" variant="academic">
  <section class="academic-hero">
    <div class="hero-copy">
      <div class="eyebrow">Research profile</div>
      <div class="title-row">
        <h1>{aboutProfile.name}</h1>
        <div class="image-card logo-card">
          <img src="/images/北京交通大学-logo.svg" alt="Beijing Jiaotong University emblem" class="media logo-media" />
        </div>
      </div>
      <p class="role">
        {aboutProfile.role}
        <span>{aboutProfile.affiliation}</span>
      </p>
      <p class="summary">{aboutProfile.bio}</p>
    </div>
    <aside class="hero-panel">
      <div class="hero-panel-inner">
        <div class="eyebrow">Current interests</div>
        <ul class="pill-list">
          {aboutProfile.interests.map((item) => <li>{item}</li>)}
        </ul>
        <p>Selected work and contact details live below, but the page now shares the same warmer editorial surface as the blog.</p>
      </div>
    </aside>
  </section>

  <section class="academic-grid">
    <article class="panel">
      <h2>Research interests</h2>
      <div class="interests-layout">
        <ul>
          {aboutProfile.interests.map((item) => <li>{item}</li>)}
        </ul>
        <div class="image-card robot-card">
          <img src="/images/embodied-robot.png" alt="Robot illustration related to embodied AI" class="media robot-media" />
        </div>
      </div>
    </article>
    <article class="panel">
      <h2>Selected work</h2>
      <ul class="works">
        {selectedWorks.map((work) => (
          <li>
            <a href={work.href}>{work.title}</a>
            <span>
              {work.venue}, {work.year}
            </span>
          </li>
        ))}
      </ul>
    </article>
  </section>
</BaseLayout>

<style>
  .academic-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.25rem;
    align-items: stretch;
  }

  h1 {
    margin: 0.55rem 0 0.75rem;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.96;
  }

  .role,
  .summary,
  .works span {
    color: var(--muted);
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-copy,
  .hero-panel-inner,
  .panel {
    border: 1px solid var(--line);
    border-radius: 2rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
  }

  .hero-copy {
    padding: clamp(1.8rem, 4vw, 3rem);
  }

  .image-card {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.4rem;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(255, 248, 240, 0.94)),
      linear-gradient(135deg, rgba(178, 76, 44, 0.1), transparent 55%);
    overflow: visible;
  }

  .media {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .logo-card {
    flex: 0 0 15rem;
    width: 15rem;
    height: 15rem;
    padding: 1rem;
  }

  .logo-media {
    width: 5rem;
    height: 5rem;
  }

  .robot-card {
    width: 15rem;
    min-height: 15rem;
    padding: 0.85rem;
  }

  .role {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .summary {
    margin: 1rem 0 0;
    line-height: 1.8;
    max-width: 56ch;
  }

  .hero-panel-inner {
    height: 100%;
    padding: 1.7rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.56), rgba(255, 248, 240, 0.92)),
      linear-gradient(135deg, rgba(178, 76, 44, 0.15), transparent 45%);
  }

  .hero-panel-inner p {
    margin: 1rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .academic-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .panel {
    padding: 1.6rem;
  }

  .panel h2 {
    margin: 0 0 0.85rem;
    font-size: 1.5rem;
    font-family: var(--serif);
  }

  .interests-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 1rem;
    align-items: stretch;
  }

  ul {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.8;
  }

  .works {
    list-style: none;
    padding: 0;
  }

  .works li + li {
    margin-top: 1rem;
  }

  .works a {
    display: block;
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  @media (max-width: 820px) {
    .academic-hero,
    .academic-grid {
      grid-template-columns: 1fr;
    }

    .title-row,
    .interests-layout {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
    }

    .logo-card {
      width: min(15rem, 100%);
      height: 15rem;
    }

    .robot-card {
      width: min(15rem, 100%);
    }
  }
</style>
