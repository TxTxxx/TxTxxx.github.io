---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredBySlot = new Map<number, (typeof posts)[number]>();

for (const slot of [1, 2] as const) {
  const candidates = posts.filter((post) => post.data.featured_slot === slot);
  if (candidates.length > 0) {
    featuredBySlot.set(
      slot,
      candidates.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0]
    );
  }
}

const featuredPosts = [1, 2]
  .map((slot) => featuredBySlot.get(slot))
  .filter(Boolean) as (typeof posts);

for (const post of posts) {
  if (featuredPosts.length >= 2) break;
  if (!featuredPosts.some((featuredPost) => featuredPost.id === post.id)) {
    featuredPosts.push(post);
  }
}

const archivePosts = posts.filter((post) => !featuredPosts.some((featuredPost) => featuredPost.id === post.id));
---

<BaseLayout title="Blog | TxTxx" description="Blog archive" pathname="/">
  <section class="blog-header">
    <div class="eyebrow">Blog archive</div>
    <h1>持续写作，而不是一次性整理。</h1>
    <p>
      这里放技术文章、研究随笔、读书摘记和还在发育中的观察。顶部是两篇置顶内容，其余文章按时间继续展开。
    </p>
  </section>

  <section class="featured-grid">
    {featuredPosts.map((post) => <PostCard post={post} variant="featured" />)}
  </section>

  <section class="archive-section">
    <div class="section-heading">
      <h2>More writing</h2>
      <span class="muted">{archivePosts.length} posts</span>
    </div>
    <div class="archive-grid">
      {archivePosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .blog-header h1 {
    margin: 0.5rem 0 1rem;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 6vw, 4.9rem);
    line-height: 0.98;
  }

  .blog-header p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .archive-section {
    margin-top: 3rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .featured-grid,
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
