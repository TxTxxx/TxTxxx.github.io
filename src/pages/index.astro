---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import NowNote from "../components/NowNote.astro";

const categoryLabels = {
  "embodied-ai": "具身智能",
  "tech-sharing": "技术分享",
  journal: "保研日志"
} as const;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredBySlot = new Map<number, (typeof posts)[number]>();

for (const slot of [1, 2] as const) {
  const candidates = posts.filter((post) => post.data.featured_slot === slot);
  if (candidates.length > 0) {
    featuredBySlot.set(
      slot,
      candidates.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0]
    );
  }
}

const featuredPosts = [1, 2]
  .map((slot) => featuredBySlot.get(slot))
  .filter(Boolean) as (typeof posts);

for (const post of posts) {
  if (featuredPosts.length >= 2) break;
  if (!featuredPosts.some((featuredPost) => featuredPost.id === post.id)) {
    featuredPosts.push(post);
  }
}

const archivePosts = posts.filter((post) => !featuredPosts.some((featuredPost) => featuredPost.id === post.id));
---

<BaseLayout title="Blog | TxTxx" description="Blog archive" pathname="/">
  <div class="home-intro">
    <section class="blog-header">
      <div class="eyebrow">Blog archive</div>
      <h1>Trying to be<br /><span>100% of CR7.</span></h1>
      <p>机器人学习、技术笔记，以及球场和生活里的记录。</p>
    </section>
    <NowNote />
  </div>

  <section class="featured-grid">
    {featuredPosts.map((post) => <PostCard post={post} variant="featured" />)}
  </section>

  <section class="archive-section">
    <div class="section-heading">
      <div class="archive-heading-copy">
        <h2>More writing</h2>
        <span class="muted archive-count">
          共 {posts.length} 篇文章
        </span>
      </div>
      <div class="archive-filter-bar">
        <div class="archive-filters" aria-label="Archive category filters">
          <button type="button" class="archive-filter active" data-filter="all">全部</button>
          <button type="button" class="archive-filter" data-filter="embodied-ai">
            <span>{categoryLabels["embodied-ai"]}</span>
          </button>
          <button type="button" class="archive-filter" data-filter="tech-sharing">
            <span>{categoryLabels["tech-sharing"]}</span>
          </button>
          <button type="button" class="archive-filter" data-filter="journal">
            <span>{categoryLabels.journal}</span>
          </button>
        </div>
      </div>
    </div>
    <div class="archive-empty muted" data-empty-state hidden>
      这个分类下暂时还没有文章。
    </div>
    <div class="archive-grid" data-archive-grid>
      {archivePosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<script>
  const defaultCategory = "all";
  const filterButtons = Array.from(document.querySelectorAll(".archive-filter"));
  const archiveGrid = document.querySelector("[data-archive-grid]");
  const archiveCards = Array.from(archiveGrid?.querySelectorAll(".post-card") ?? []);
  const emptyState = document.querySelector("[data-empty-state]");

  const applyFilter = (category) => {
    let visibleCount = 0;

    archiveCards.forEach((card) => {
      const matches = category === "all" || card.dataset.category === category;
      card.toggleAttribute("hidden", !matches);
      if (matches) visibleCount += 1;
    });

    filterButtons.forEach((button) => {
      const isActive = button.dataset.filter === category;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });

    if (emptyState && archiveGrid) {
      emptyState.toggleAttribute("hidden", visibleCount !== 0);
      archiveGrid.toggleAttribute("hidden", visibleCount === 0);
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.filter ?? defaultCategory;
      applyFilter(category);
    });
  });

  applyFilter(defaultCategory);
</script>

<style>
  .home-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 0.5rem 0 3.25rem;
  }

  .blog-header { min-width: 0; }

  .blog-header h1 {
    margin: 0.85rem 0 1.25rem;
    font-family: var(--serif);
    font-size: clamp(2.65rem, 5.6vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .blog-header h1 span { color: var(--accent); font-style: italic; }

  .blog-header p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .featured-grid,
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .archive-section { margin-top: 4rem; }

  .section-heading {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    font-size: clamp(1.65rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .archive-heading-copy {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .archive-count { font-size: 0.8125rem; }
  .archive-filter-bar { min-width: 0; }

  .archive-filters {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .archive-filter {
    min-height: 2.75rem;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.65rem 0.8rem;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .archive-filter:hover { color: var(--text); background: var(--surface-subtle); }
  .archive-filter.active { color: var(--accent); background: var(--accent-soft); }

  .archive-empty {
    padding: 1.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.85;
  }

  .archive-grid { gap: 1.5rem; }
  .archive-grid[hidden], .archive-empty[hidden] { display: none; }

  @media (max-width: 900px) {
    .archive-grid { gap: 1rem; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 0.85rem; }
    .archive-filters { justify-content: flex-start; }
    .archive-filter:first-child { margin-left: -0.8rem; }
  }

  @media (max-width: 820px) {
    .home-intro { flex-wrap: wrap; gap: 1.75rem; padding-bottom: 2.25rem; }
  }

  @media (max-width: 540px) {
    .archive-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .featured-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .archive-section { margin-top: 2.75rem; }
    .archive-filter { padding-inline: 0.7rem; }
    .archive-filter:first-child { margin-left: -0.7rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-filter { transition: none; }
  }
</style>
