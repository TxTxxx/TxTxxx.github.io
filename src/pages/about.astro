---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutProfile, siteMeta } from "../data/profile";
---

<BaseLayout title="About | TxTxx" description="About page" pathname="/about" variant="academic">
  <section class="about-wrap">
    <div class="section-heading">
      <div>
        <div class="eyebrow">About</div>
        <h1>A concise academic page, separate from the blog stream.</h1>
      </div>
    </div>

    <div class="about-grid">
      <article class="panel">
        <h2>Bio</h2>
        <p>{aboutProfile.bio}</p>
      </article>
      <article class="panel">
        <h2>Contact</h2>
        <ul class="contact-list">
          <li>
            <span>Email</span>
            <a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
          </li>
          <li>
            <span>GitHub</span>
            <a href={siteMeta.github}>{siteMeta.github}</a>
          </li>
          <li>
            <span>Scholar</span>
            <a href={siteMeta.scholar}>{siteMeta.scholar}</a>
          </li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .about-wrap {
    max-width: 60rem;
  }

  h1 {
    max-width: 13ch;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1rem;
  }

  .panel {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--bg-elevated);
  }

  .panel h2 {
    margin-top: 0;
  }

  .panel p {
    margin-bottom: 0;
    line-height: 1.8;
    color: var(--muted);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li + li {
    margin-top: 1rem;
  }

  .contact-list span {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
