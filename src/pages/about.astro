---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutProfile, siteMeta } from "../data/profile";
---

<BaseLayout title="About | TxTxx" description="About page" pathname="/about" variant="academic">
  <section class="about-wrap">
    <div class="about-hero">
      <div class="hero-copy">
        <div class="eyebrow">About</div>
        <h1>{aboutProfile.name}</h1>
        <p>{aboutProfile.bio}</p>
      </div>
      <div class="hero-panel">
        <div class="hero-panel-inner">
          <div class="eyebrow">Profile snapshot</div>
          <ul class="pill-list">
            <li>{aboutProfile.role}</li>
            <li>{aboutProfile.affiliation}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="about-grid">
      <article class="panel">
        <h2>Research interests</h2>
        <p>{aboutProfile.interests.join(" · ")}</p>
      </article>
      <article class="panel">
        <h2>Contact</h2>
        <ul class="contact-list">
          <li>
            <span>Email</span>
            <a href={`mailto:${siteMeta.email}`}>{siteMeta.email}</a>
          </li>
          <li>
            <span>GitHub</span>
            <a href={siteMeta.github}>{siteMeta.github}</a>
          </li>
          {siteMeta.scholar && siteMeta.scholar !== "#" && <li>
            <span>Scholar</span>
            <a href={siteMeta.scholar}>{siteMeta.scholar}</a>
          </li>}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .about-wrap {
    max-width: 60rem;
  }

  .about-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  h1 {
    max-width: 12ch;
    margin: 0.45rem 0 0.9rem;
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    line-height: 0.98;
    font-family: var(--serif);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1rem;
  }

  .hero-copy,
  .hero-panel-inner,
  .panel {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
  }

  .hero-copy p {
    margin: 0;
    line-height: 1.8;
    color: var(--muted);
  }

  .hero-panel-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background:
      var(--paper-gradient),
      linear-gradient(135deg, var(--accent-soft), transparent 45%);
  }

  .panel h2 {
    margin: 0 0 0.85rem;
    font-family: var(--serif);
  }

  .panel p {
    margin-bottom: 0;
    line-height: 1.8;
    color: var(--muted);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li + li {
    margin-top: 1rem;
  }

  .contact-list span {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 820px) {
    .about-hero,
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
