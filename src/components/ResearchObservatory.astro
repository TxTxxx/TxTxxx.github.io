---
import graph from "../data/researchGraph.json";

const statusLabels: Record<string, string> = {
  inbox: "待读入库",
  skimmed: "已经浏览",
  reading: "正在精读",
  digested: "完成消化",
  archived: "暂时归档"
};
const paperNodes = [...graph.nodes]
  .filter((node) => node.type === "paper")
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || b.maturity - a.maturity);
const featuredNode = [...paperNodes].sort((a, b) => b.maturity - a.maturity)[0];
const conciseAuthors = (authors: string) => {
  const names = authors.split(",").map((name) => name.trim()).filter(Boolean);
  if (names.length <= 3) return names.join(", ");
  return `${names.slice(0, 3).join(", ")} 等 ${names.length} 位作者`;
};
const generatedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Shanghai"
}).format(new Date(graph.generatedAt));
const graphJson = JSON.stringify(graph).replaceAll("<", "\\u003c");
---

<div class="observatory-breakout">
  <section class="observatory-hero">
    <div class="hero-copy">
      <div class="signal-line">
        <span class="live-dot"></span>
        <span>Research Observatory · Live knowledge system</span>
      </div>
      <h1>把读过的论文，<br />连成一片研究宇宙。</h1>
      <p>
        从 Zotero 的阅读入口，到 Obsidian 里的判断、概念与连接。这里展示的是一套正在形成的研究结构，而不是一张静止的论文清单。
      </p>
    </div>
    <dl class="telemetry" aria-label="研究图谱概况">
      <div><dt>PAPERS</dt><dd>{graph.stats.papers.toString().padStart(2, "0")}</dd></div>
      <div><dt>NODES</dt><dd>{graph.stats.nodes.toString().padStart(2, "0")}</dd></div>
      <div><dt>LINKS</dt><dd>{graph.stats.connections.toString().padStart(2, "0")}</dd></div>
      <div><dt>EVIDENCE</dt><dd>{graph.stats.evidenceSignals.toString().padStart(2, "0")}</dd></div>
    </dl>
  </section>

  <section class="map-shell" aria-labelledby="constellation-title">
    <header class="map-toolbar">
      <div>
        <span class="map-index">MAP / 01 · PERSONAL RESEARCH SPACE</span>
        <h2 id="constellation-title">Knowledge Constellation</h2>
      </div>
      <div class="map-actions">
        <label class="graph-search">
          <span>SEARCH /</span>
          <input type="search" placeholder="论文或概念" autocomplete="off" data-graph-search />
        </label>
        <div class="type-filters" aria-label="节点类型筛选">
          <button type="button" class="active" data-type-filter="all" aria-pressed="true">全部 {graph.stats.nodes}</button>
          <button type="button" data-type-filter="paper" aria-pressed="false"><i data-kind="paper"></i>论文</button>
          <button type="button" data-type-filter="concept" aria-pressed="false"><i data-kind="concept"></i>概念</button>
          <button type="button" data-type-filter="fragment" aria-pressed="false"><i data-kind="fragment"></i>碎片</button>
        </div>
        <button type="button" class="reset-view" data-reset-view>重置视野</button>
      </div>
    </header>

    <div class="map-layout">
      <div class="constellation-stage">
        <div class="atmosphere" aria-hidden="true"></div>
        <div class="coordinate-grid" aria-hidden="true"></div>
        <div class="sigma-mount" data-sigma-mount aria-label="可交互研究知识星图"></div>
        <div class="axis-label axis-x">CONCEPTUAL DISTANCE →</div>
        <div class="axis-label axis-y">READING SIGNAL →</div>
        <p class="map-hint">滚动缩放 · 拖动漫游 · 点击聚焦</p>
      </div>

      <aside class="node-inspector" data-node-inspector aria-live="polite">
        <div class="inspector-topline">
          <span data-detail-type>论文</span>
          <span data-detail-signal>{featuredNode?.maturity ?? 0}% SIGNAL</span>
        </div>
        <h3 data-detail-title>{featuredNode?.title}</h3>
        <p class="detail-authors" data-detail-authors>{featuredNode?.authors}</p>
        <div class="detail-meta">
          <span data-detail-year>{featuredNode?.year ?? "时间待校对"}</span>
          <span data-detail-status>待读入库</span>
          <span data-detail-role>{featuredNode?.paperRole || featuredNode?.readingLevel || "VLA"}</span>
        </div>
        <div class="signal-meter" aria-label="笔记信号强度">
          <span style={`--meter:${featuredNode?.maturity ?? 0}%`} data-detail-meter></span>
        </div>
        <dl class="detail-stats">
          <div><dt>笔记判断</dt><dd data-detail-notes>{featuredNode?.noteDensity ?? 0}</dd></div>
          <div><dt>证据标记</dt><dd data-detail-evidence>{featuredNode?.evidenceCount ?? 0}</dd></div>
          <div><dt>直接连接</dt><dd data-detail-connections>0</dd></div>
        </dl>
        <p class="privacy-note">公开的是结构化阅读信号。私人正文和 Zotero 原始批注不会进入网站。</p>
        <div class="detail-actions">
          <a data-detail-source href={featuredNode?.sourceUrl || undefined} target="_blank" rel="noreferrer" hidden={!featuredNode?.sourceUrl}>阅读原文</a>
          <a data-detail-zotero href={featuredNode?.zoteroUri || undefined} hidden={!featuredNode?.zoteroUri}>在 Zotero 打开</a>
        </div>
      </aside>
    </div>

    <footer class="map-footer">
      <span>OBSIDIAN SNAPSHOT · {generatedDate}</span>
      <span>人工 WikiLink 关系以高亮实线呈现</span>
    </footer>
  </section>

  <section class="reading-trajectory" aria-labelledby="trajectory-title">
    <header class="trajectory-heading">
      <div>
        <span class="map-index">INDEX / 02 · READING TRAJECTORY</span>
        <h2 id="trajectory-title">论文不是收藏，<br />而是一条逐渐清晰的方法轨迹。</h2>
      </div>
      <p>
        时间轴按论文发表年份排列；“研究信号”由阅读层级、笔记判断与证据标记综合得到，避免只用一个容易忘记更新的状态字段判断阅读深度。
      </p>
    </header>

    <div class="paper-timeline">
      {
        paperNodes.map((paper, index) => (
          <article class="timeline-paper" style={`--paper-signal:${paper.maturity}%`}>
            <div class="timeline-marker">
              <span>{paper.year ?? "—"}</span>
              <i></i>
            </div>
            <div class="paper-record">
              <div class="record-sequence">P-{String(index + 1).padStart(2, "0")}</div>
              <h3>{paper.title}</h3>
              <p>{conciseAuthors(paper.authors)}</p>
              <div class="record-tags">
                <span>{statusLabels[paper.status] ?? paper.status}</span>
                <span>{paper.paperRole || paper.readingLevel || "VLA"}</span>
                <span>{paper.noteDensity} 条笔记判断</span>
              </div>
              <div class="record-signal"><span></span><b>{paper.maturity}%</b></div>
              <div class="record-links">
                {paper.sourceUrl && <a href={paper.sourceUrl} target="_blank" rel="noreferrer">原文 ↗</a>}
                {paper.zoteroUri && <a href={paper.zoteroUri}>Zotero ↗</a>}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="pipeline-band" aria-label="研究工作流说明">
    <div><span>01</span><strong>Zotero</strong><p>论文事实、PDF 与批注原材料</p></div>
    <i aria-hidden="true">→</i>
    <div><span>02</span><strong>Obsidian</strong><p>判断、概念与人工知识连接</p></div>
    <i aria-hidden="true">→</i>
    <div><span>03</span><strong>Observatory</strong><p>经过隐私过滤的公开研究结构</p></div>
  </section>

  <script id="research-graph-data" type="application/json" set:html={graphJson}></script>
</div>

<script>
  import Graph from "graphology";
  import Sigma from "sigma";
  import forceAtlas2 from "graphology-layout-forceatlas2";

  const dataElement = document.querySelector("#research-graph-data");
  const mount = document.querySelector("[data-sigma-mount]");
  const inspector = document.querySelector("[data-node-inspector]");
  const resetButton = document.querySelector("[data-reset-view]");
  const searchInput = document.querySelector("[data-graph-search]");
  const filterButtons = Array.from(document.querySelectorAll("[data-type-filter]"));
  const graphData = dataElement ? JSON.parse(dataElement.textContent || "{}") : { nodes: [], edges: [] };
  const nodeData = new Map(graphData.nodes.map((node) => [node.id, node]));

  const typeLabels = {
    field: "研究领域",
    paper: "论文",
    concept: "概念",
    fragment: "研究碎片"
  };
  const statusLabels = {
    inbox: "待读入库",
    skimmed: "已经浏览",
    reading: "正在精读",
    digested: "完成消化",
    archived: "暂时归档",
    developing: "持续生长",
    legacy: "待结构化"
  };
  const colors = {
    field: "#ffd083",
    paper: "#76e8fb",
    concept: "#ff9d70",
    fragment: "#567180"
  };

  const stableAngle = (value) => {
    let hash = 0;
    for (let index = 0; index < value.length; index += 1) hash = (hash * 31 + value.charCodeAt(index)) | 0;
    return (Math.abs(hash) % 360) * (Math.PI / 180);
  };

  if (mount && graphData.nodes.length) {
    const knowledgeGraph = new Graph({ type: "undirected", multi: false });

    graphData.nodes.forEach((node, index) => {
      const angle = stableAngle(node.id);
      const radius = node.type === "field" ? 0.2 : node.type === "concept" ? 3.4 : node.type === "paper" ? 6.2 : 10 + (index % 3) * 0.7;
      const size = node.type === "field"
        ? 18
        : node.type === "concept"
          ? 12
          : node.type === "paper"
            ? 7 + node.maturity / 11
            : 3.2 + Math.min(node.maturity, 50) / 32;

      knowledgeGraph.addNode(node.id, {
        ...node,
        x: Math.cos(angle) * radius,
        y: Math.sin(angle) * radius,
        size,
        color: colors[node.type] || colors.fragment,
        label: node.title,
        zIndex: node.type === "field" ? 4 : node.type === "paper" ? 3 : node.type === "concept" ? 2 : 1
      });
    });

    graphData.edges.forEach((edge, index) => {
      if (!knowledgeGraph.hasNode(edge.source) || !knowledgeGraph.hasNode(edge.target)) return;
      knowledgeGraph.addEdgeWithKey(`edge-${index}`, edge.source, edge.target, {
        size: 1,
        color: "rgba(74, 126, 145, 0.34)",
        kind: edge.kind
      });
    });

    const inferred = forceAtlas2.inferSettings(knowledgeGraph);
    forceAtlas2.assign(knowledgeGraph, {
      iterations: 180,
      settings: {
        ...inferred,
        gravity: 0.85,
        scalingRatio: 7.5,
        slowDown: 2,
        barnesHutOptimize: false,
        strongGravityMode: false
      }
    });

    let selectedNode = graphData.nodes
      .filter((node) => node.type === "paper")
      .sort((a, b) => b.maturity - a.maturity)[0]?.id || null;
    let hoveredNode = null;
    let activeType = "all";
    let searchQuery = "";

    const activeNeighborhood = () => {
      const active = hoveredNode || selectedNode;
      if (!active) return null;
      return new Set([active, ...knowledgeGraph.neighbors(active)]);
    };

    const renderer = new Sigma(knowledgeGraph, mount, {
      allowInvalidContainer: false,
      defaultEdgeType: "line",
      defaultDrawNodeHover: () => {},
      labelColor: { color: "#b9d6de" },
      labelFont: "IBM Plex Mono, SFMono-Regular, monospace",
      labelSize: 11,
      labelDensity: 0.85,
      labelGridCellSize: 120,
      labelRenderedSizeThreshold: 6,
      edgeColor: "attribute",
      hideEdgesOnMove: false,
      renderEdgeLabels: false,
      enableEdgeEvents: false,
      zIndex: true,
      minCameraRatio: 0.18,
      maxCameraRatio: 4.5,
      nodeReducer: (node, attributes) => {
        const result = { ...attributes };
        const sourceNode = nodeData.get(node);
        if (activeType !== "all" && sourceNode?.type !== activeType) {
          result.hidden = true;
          return result;
        }
        if (searchQuery && !sourceNode?.title?.toLocaleLowerCase().includes(searchQuery)) {
          result.color = "#1b2c35";
          result.label = "";
        }
        const neighborhood = activeNeighborhood();
        if (neighborhood && !neighborhood.has(node)) {
          result.color = "#1f323d";
          result.label = "";
          result.zIndex = 0;
        }
        if (node === selectedNode || node === hoveredNode) {
          result.color = "#e6fcff";
          result.size = attributes.size * 1.22;
          result.zIndex = 10;
          result.forceLabel = true;
        }
        return result;
      },
      edgeReducer: (edge, attributes) => {
        const result = { ...attributes };
        const extremities = knowledgeGraph.extremities(edge);
        if (activeType !== "all" && extremities.some((node) => nodeData.get(node)?.type !== activeType)) {
          result.hidden = true;
          return result;
        }
        const active = hoveredNode || selectedNode;
        if (!active) return result;
        const touchesActive = extremities.includes(active);
        result.color = touchesActive ? "rgba(118, 232, 251, 0.88)" : "rgba(31, 54, 65, 0.16)";
        result.size = touchesActive ? 2.2 : 0.5;
        return result;
      }
    });

    const setText = (selector, value) => {
      const element = inspector?.querySelector(selector);
      if (element) element.textContent = value || "—";
    };

    const updateInspector = (nodeId) => {
      const node = nodeData.get(nodeId);
      if (!node || !inspector) return;
      setText("[data-detail-type]", typeLabels[node.type] || node.type);
      setText("[data-detail-signal]", `${node.maturity}% SIGNAL`);
      setText("[data-detail-title]", node.title);
      setText("[data-detail-authors]", node.authors || "由 Obsidian 知识关系生成");
      setText("[data-detail-year]", node.year || "时间待校对");
      setText("[data-detail-status]", statusLabels[node.status] || node.status);
      setText("[data-detail-role]", node.paperRole || node.readingLevel || node.topics?.[0] || typeLabels[node.type]);
      setText("[data-detail-notes]", String(node.noteDensity || 0));
      setText("[data-detail-evidence]", String(node.evidenceCount || 0));
      setText("[data-detail-connections]", String(knowledgeGraph.degree(nodeId)));
      inspector.querySelector("[data-detail-meter]")?.style.setProperty("--meter", `${node.maturity}%`);

      const sourceLink = inspector.querySelector("[data-detail-source]");
      const zoteroLink = inspector.querySelector("[data-detail-zotero]");
      sourceLink?.toggleAttribute("hidden", !node.sourceUrl);
      zoteroLink?.toggleAttribute("hidden", !node.zoteroUri);
      if (sourceLink && node.sourceUrl) sourceLink.href = node.sourceUrl;
      if (zoteroLink && node.zoteroUri) zoteroLink.href = node.zoteroUri;
    };

    const focusNode = (nodeId, moveCamera = true) => {
      selectedNode = nodeId;
      updateInspector(nodeId);
      renderer.refresh();
      if (!moveCamera) return;
      const displayData = renderer.getNodeDisplayData(nodeId);
      if (displayData) renderer.getCamera().animate({ x: displayData.x, y: displayData.y, ratio: 0.52 }, { duration: 650 });
    };

    renderer.on("enterNode", ({ node }) => {
      hoveredNode = node;
      mount.classList.add("is-hovering");
      renderer.refresh();
    });
    renderer.on("leaveNode", () => {
      hoveredNode = null;
      mount.classList.remove("is-hovering");
      renderer.refresh();
    });
    renderer.on("clickNode", ({ node }) => focusNode(node));
    renderer.on("clickStage", () => {
      selectedNode = null;
      renderer.refresh();
    });

    resetButton?.addEventListener("click", () => {
      selectedNode = null;
      activeType = "all";
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      filterButtons.forEach((button) => {
        const active = button.dataset.typeFilter === "all";
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      renderer.refresh();
      renderer.getCamera().animatedReset({ duration: 600 });
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeType = button.dataset.typeFilter || "all";
        selectedNode = null;
        filterButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle("active", active);
          candidate.setAttribute("aria-pressed", String(active));
        });
        renderer.refresh();
        renderer.getCamera().animatedReset({ duration: 450 });
      });
    });

    searchInput?.addEventListener("input", () => {
      searchQuery = searchInput.value.trim().toLocaleLowerCase();
      renderer.refresh();
    });
    searchInput?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || !searchQuery) return;
      const match = graphData.nodes.find((node) => node.title.toLocaleLowerCase().includes(searchQuery));
      if (match) focusNode(match.id);
    });

    if (selectedNode) focusNode(selectedNode, false);
  }
</script>

<style>
  .observatory-breakout {
    width: 100vw;
    margin: -3.5rem 0 -5rem calc(50% - 50vw);
    padding: clamp(3.5rem, 7vw, 6.5rem) max(1rem, calc((100vw - var(--max-width)) / 2)) 6rem;
    color: #eaf8ff;
    background:
      radial-gradient(circle at 10% 8%, rgba(72, 112, 245, 0.2), transparent 29rem),
      radial-gradient(circle at 86% 16%, rgba(59, 225, 205, 0.13), transparent 27rem),
      linear-gradient(180deg, #061019 0%, #081620 52%, #050e15 100%);
  }

  .observatory-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: 2.7rem;
  }

  .signal-line,
  .map-index,
  .map-footer,
  .inspector-topline,
  .axis-label,
  .map-hint {
    font-family: var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .signal-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #7ddfeb;
    font-size: 0.7rem;
  }

  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #71f5c8;
    box-shadow: 0 0 1rem rgba(113, 245, 200, 0.9);
    animation: signal-pulse 2.4s ease-in-out infinite;
  }

  .hero-copy h1 {
    margin: 1rem 0 1.25rem;
    max-width: 13ch;
    font-family: var(--serif);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-copy p {
    max-width: 47rem;
    margin: 0;
    color: #91a8b5;
    line-height: 1.85;
  }

  .telemetry {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid rgba(164, 220, 238, 0.18);
    border-left: 1px solid rgba(164, 220, 238, 0.18);
  }

  .telemetry div {
    display: flex;
    min-height: 6.1rem;
    padding: 1rem;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid rgba(164, 220, 238, 0.18);
    border-bottom: 1px solid rgba(164, 220, 238, 0.18);
    background: rgba(10, 29, 42, 0.5);
  }

  .telemetry dt { color: #688392; font-size: 0.65rem; letter-spacing: 0.1em; }
  .telemetry dd { margin: 0; color: #dff9ff; font-family: var(--mono); font-size: 1.75rem; }

  .map-shell {
    overflow: hidden;
    border: 1px solid rgba(142, 219, 241, 0.2);
    border-radius: 1.4rem;
    background: rgba(4, 13, 20, 0.84);
    box-shadow: 0 2.5rem 6rem rgba(0, 0, 0, 0.38);
  }

  .map-toolbar,
  .map-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.4rem;
  }

  .map-toolbar { border-bottom: 1px solid rgba(142, 219, 241, 0.16); }
  .map-index { color: #4e7485; font-size: 0.6rem; }
  .map-toolbar h2 { margin: 0.25rem 0 0; font-family: var(--serif); font-size: clamp(1.45rem, 3vw, 2.15rem); font-weight: 500; }
  .map-actions { display: flex; align-items: center; gap: 0.65rem; }
  .graph-search { display: flex; align-items: center; gap: 0.45rem; padding: 0.48rem 0.6rem; border: 1px solid rgba(118, 232, 251, 0.16); color: #4e7485; font-family: var(--mono); font-size: 0.58rem; }
  .graph-search input { width: 7.5rem; padding: 0; border: 0; outline: 0; color: #c5e8ee; background: transparent; font: inherit; }
  .graph-search input::placeholder { color: #486673; }
  .type-filters { display: flex; gap: 0.35rem; }
  .type-filters button { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.5rem 0.58rem; border: 1px solid rgba(118, 232, 251, 0.12); color: #6f8b98; background: transparent; font: inherit; font-size: 0.62rem; cursor: pointer; }
  .type-filters button:hover, .type-filters button:focus-visible, .type-filters button.active { border-color: rgba(118, 232, 251, 0.38); color: #d8f7fb; background: rgba(82, 191, 210, 0.1); }
  .type-filters i { display: inline-block; width: 0.38rem; height: 0.38rem; border-radius: 50%; background: #76e8fb; box-shadow: 0 0 0.55rem rgba(118, 232, 251, 0.65); }
  .type-filters [data-kind="concept"] { background: #ff9d70; box-shadow: 0 0 0.55rem rgba(255, 157, 112, 0.55); }
  .type-filters [data-kind="fragment"] { background: #567180; box-shadow: none; }
  .reset-view { padding: 0.55rem 0.7rem; border: 1px solid rgba(118, 232, 251, 0.2); color: #8fc5d1; background: rgba(76, 178, 198, 0.06); font: inherit; font-size: 0.68rem; cursor: pointer; }
  .reset-view:hover, .reset-view:focus-visible { border-color: rgba(118, 232, 251, 0.55); color: #e6fbff; }

  .map-layout { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; min-height: 43rem; }
  .constellation-stage { position: relative; min-width: 0; overflow: hidden; border-right: 1px solid rgba(142, 219, 241, 0.14); isolation: isolate; }
  .sigma-mount { position: absolute; inset: 0; z-index: 3; }
  .sigma-mount :global(canvas) { cursor: grab; }
  .sigma-mount.is-hovering :global(canvas) { cursor: pointer; }
