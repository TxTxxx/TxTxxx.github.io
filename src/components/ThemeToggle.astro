<style>
  .theme-toggle { display: inline-grid; place-items: center; flex: 0 0 auto; width: 2.75rem; height: 2.75rem; padding: 0.6rem; border: 1px solid var(--line); border-radius: 50%; color: var(--muted); background: var(--bg-elevated); cursor: pointer; }
  .theme-toggle:hover { color: var(--text); border-color: var(--accent); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .theme-toggle svg { grid-area: 1 / 1; width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: opacity 150ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1); }
  .theme-sun { opacity: 0; transform: rotate(-60deg) scale(0.7); }
  .theme-moon { opacity: 1; transform: rotate(0) scale(1); }
  :global(html[data-theme="dark"]) .theme-moon { opacity: 0; transform: rotate(40deg) scale(0.7); }
  :global(html[data-theme="dark"]) .theme-sun { opacity: 1; transform: rotate(0) scale(1); }
  .theme-toggle { transition: border-color 150ms ease, color 150ms ease; }
  @media (prefers-reduced-motion: reduce) {
