---
import { getEntry, render } from "astro:content";

const entry = await getEntry("now", "now");
// A missing, draft or empty note stays invisible; no invented activity or placeholder copy.
const hasText = Boolean(entry?.body?.replace(/<!--[\s\S]*?-->/g, "").trim());
const visible = Boolean(entry && !entry.data.draft && hasText);
const rendered = visible && entry ? await render(entry) : null;
const Content = rendered?.Content;
const date = entry?.data.updated?.toISOString().slice(0, 10);
---

{Content && <section class="now-note" aria-labelledby="now-heading" data-now-note>
  <header>
    <h2 id="now-heading">最近在做什么</h2>
    {date && <time datetime={date}>更新于 {date}</time>}
  </header>
  <div class="now-copy"><Content /></div>
</section>}

<style>
  .now-note { flex: 0 1 18rem; min-width: 0; padding: 0.25rem 0 0.25rem 1.5rem; border-left: 1px solid var(--line); }
  .now-note h2 { margin: 0; font-size: 0.9375rem; font-weight: 500; line-height: 1.6; }
  .now-note time { display: block; margin-top: 0.4rem; color: var(--muted); font-family: var(--mono); font-size: 0.875rem; line-height: 1.6; }
  .now-copy { min-width: 0; margin-top: 0.85rem; color: var(--text); font-size: 1rem; line-height: 1.85; overflow-wrap: anywhere; }
  .now-copy :global(p) { margin: 0 0 0.65rem; }
  .now-copy :global(ul), .now-copy :global(ol) { margin: 0 0 0.65rem; padding-left: 1.3rem; }
  .now-copy :global(> :last-child) { margin-bottom: 0; }
  .now-copy :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 820px) {
    .now-note { flex-basis: 100%; padding: 1.25rem 0 0; border-left: 0; border-top: 1px solid var(--line); }
    .now-note header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .now-note time { margin: 0; }
    .now-copy { margin-top: 0.5rem; }
  }
</style>
