---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "default" | "featured";
}

const { post, variant = "default" } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
const hasImage = Boolean(post.data.cover_image);
const category = post.data.category ?? (post.id.startsWith("journal/") ? "journal" : "tech-sharing");
---

<article
  class:list={[
    "post-card",
    variant === "featured" ? "featured" : undefined,
    hasImage ? "with-image" : "text-only",
    post.data.cover_fit === "cover" ? "cover-image" : undefined,
    category === "journal" && variant !== "featured" ? "journal-card" : undefined
  ]}
  data-category={category}
  data-cover-fit={post.data.cover_fit ?? "contain"}
>
  <a href={`/blog/${post.id}/`} class="post-card-link">
    {
      hasImage && (
        <div class="post-card-media">
          <div class="post-card-media-frame">
            <img
              src={post.data.cover_image}
              alt={post.data.cover_alt ?? post.data.title}
              loading={variant === "featured" ? "eager" : "lazy"}
              decoding="async"
            />
          </div>
        </div>
      )
    }
    <div class="post-card-copy">
      <div class="post-card-meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formattedDate}</time>
        {variant === "featured" && <span>{post.data.tags.join(" / ")}</span>}
      </div>
      <h3>{post.data.title}</h3>
      <p>{post.data.summary}</p>
    </div>
  </a>
</article>

<style>
  .post-card {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--bg-elevated);
    transition: border-color 180ms ease;
  }

  .post-card[hidden] { display: none; }
  .post-card:hover { border-color: var(--accent-line); }

  .post-card-link {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    height: 100%;
    border-radius: inherit;
  }

  .post-card-copy {
    flex: 1;
    min-width: 0;
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .post-card-link:hover h3,
  .post-card-link:focus-visible h3 { color: var(--accent); }

  .post-card-media {
    flex: none;
    width: 100%;
    min-width: 0;
    padding: 0.75rem 0.75rem 0;
  }

  .post-card-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    border-radius: 0.65rem;
    overflow: hidden;
    background: var(--surface-subtle);
  }

  .post-card-media img {
    /* Keep intrinsic image dimensions out of the card's layout calculation. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .post-card.cover-image .post-card-media img { object-fit: cover; }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.8rem;
    row-gap: 0.25rem;
    margin-bottom: 0.65rem;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .post-card-meta time { font-variant-numeric: tabular-nums; }

  h3 {
    margin: 0 0 0.55rem;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: color 180ms ease;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .featured .post-card-media-frame { aspect-ratio: 16 / 9; }
  .featured .post-card-copy { padding: 1.4rem 1.5rem 1.6rem; }
  .featured .post-card-meta { margin-bottom: 0.85rem; font-size: 0.8125rem; }
  .featured h3 { font-size: clamp(1.4rem, 2.3vw, 1.8rem); line-height: 1.4; margin-bottom: 0.75rem; }
  .featured.text-only .post-card-copy { padding-top: 2rem; }

  @media (max-width: 600px) {
    .post-card-copy { padding: 1.1rem 1.25rem 1.35rem; }
    .post-card-meta { font-size: 0.75rem; column-gap: 0.6rem; }
    h3 { font-size: 1.25rem; }
    .featured .post-card-copy { padding: 1.15rem 1.25rem 1.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card, h3 { transition: none; }
  }
</style>
