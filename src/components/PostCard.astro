---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "default" | "featured";
}

const { post, variant = "default" } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
const hasImage = Boolean(post.data.cover_image);
const category = post.id.split("/")[0] ?? "blog";
---

<article
  class:list={[
    "post-card",
    variant === "featured" ? "featured" : undefined,
    hasImage ? "with-image" : "text-only",
    category === "journal" && variant !== "featured" ? "journal-card" : undefined
  ]}
  data-category={category}
>
  <a href={`/blog/${post.id}/`} class="post-card-link">
    {
      hasImage && (
        <div class="post-card-media">
          <div class="post-card-media-frame">
            <img src={post.data.cover_image} alt={post.data.cover_alt ?? post.data.title} loading="lazy" />
          </div>
        </div>
      )
    }
    <div class="post-card-meta">
      <span>{formattedDate}</span>
      <span>{post.data.tags.join(" / ")}</span>
    </div>
    <h3>{post.data.title}</h3>
    <p>{post.data.summary}</p>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--line);
    border-radius: 1.6rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .post-card-link {
    display: block;
    height: 100%;
    padding: 1.4rem;
  }

  .post-card.with-image .post-card-link {
    padding: 0;
  }

  .post-card-link:hover h3,
  .post-card-link:focus-visible h3 {
    color: var(--accent);
  }

  .post-card-media {
    aspect-ratio: 16 / 10;
    padding: 1rem;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.5), rgba(255, 248, 240, 0.82)),
      linear-gradient(135deg, rgba(178, 76, 44, 0.2), transparent 45%);
    border-bottom: 1px solid var(--line);
  }

  .post-card-media-frame {
    width: 100%;
    height: 100%;
    border-radius: 1.15rem;
    overflow: hidden;
    background: rgba(255, 251, 244, 0.72);
    border: 1px solid rgba(31, 30, 26, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.75);
  }

  .post-card.with-image .post-card-meta,
  .post-card.with-image h3,
  .post-card.with-image p {
    margin-left: 1.4rem;
    margin-right: 1.4rem;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
    font-family: var(--serif);
    transition: color 180ms ease;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .post-card.with-image p {
    margin-bottom: 1.4rem;
  }

  .post-card.featured {
    border-radius: 2rem;
  }

  .post-card.featured .post-card-link {
    padding: 1.8rem;
  }

  .post-card.featured.with-image .post-card-link {
    padding: 0;
  }

  .post-card.featured .post-card-media {
    aspect-ratio: 16 / 9;
    padding: 1.2rem;
  }

  .post-card.featured .post-card-media-frame {
    border-radius: 1.35rem;
  }

  .post-card.featured h3 {
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .post-card.featured.with-image .post-card-meta,
  .post-card.featured.with-image h3,
  .post-card.featured.with-image p {
    margin-left: 1.8rem;
    margin-right: 1.8rem;
  }

  .post-card.featured.with-image p {
    margin-bottom: 1.8rem;
  }

  .post-card.journal-card {
    border-radius: 1.2rem;
    background: rgba(255, 252, 247, 0.72);
    box-shadow: 0 10px 20px rgba(33, 26, 15, 0.05);
  }

  .post-card.journal-card .post-card-link {
    padding: 0.9rem 0.95rem 1rem;
  }

  .post-card.journal-card.with-image .post-card-link {
    padding: 0;
  }

  .post-card.journal-card .post-card-media {
    aspect-ratio: 16 / 10;
    padding: 0.65rem;
  }

  .post-card.journal-card .post-card-media-frame {
    border-radius: 0.95rem;
  }

  .post-card.journal-card.with-image .post-card-meta,
  .post-card.journal-card.with-image h3,
  .post-card.journal-card.with-image p {
    margin-left: 0.95rem;
    margin-right: 0.95rem;
  }

  .post-card.journal-card .post-card-meta {
    gap: 0.55rem;
    font-size: 0.74rem;
    margin-bottom: 0.45rem;
  }

  .post-card.journal-card h3 {
    font-size: 1rem;
    line-height: 1.2;
    margin-bottom: 0.3rem;
  }

  .post-card.journal-card p {
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .post-card.journal-card.with-image p {
    margin-bottom: 0.95rem;
  }
</style>
